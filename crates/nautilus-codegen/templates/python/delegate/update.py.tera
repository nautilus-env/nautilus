{%- if not is_view %}
    {% if is_async %}async {% endif %}def update(
        self,
        *,
        where: Optional[{{ model_name }}WhereInput] = None,
        data: {{ model_name }}UpdateInput,
        return_data: bool = True,
    ):
        """Update {{ model_name }} records matching ``where``.

        Args:
            where: Filter conditions. If ``None``, all records are updated.
            data: Fields to update.
            return_data: When ``True`` (default) returns the updated records.
                Set to ``False`` for bulk updates to skip ``RETURNING`` overhead;
                the affected-row count is returned instead.

        Returns:
            ``List[{{ model_name }}]`` when ``return_data=True``, or ``int``
            (affected-row count) when ``return_data=False``.
        """
        _args: Dict[str, Any] = {
            "where": where,
            "data": data,
            "return_data": return_data,
        }
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "{{ model_name }}",
            "filter": _process_where_filters(where or {}, _{{ table_name }}_py_to_db),
            "data": _process_create_data(data, _{{ table_name }}_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _{{ snake_name }}_event_context(
                self._client, "update", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = {% if is_async %}await run_crud_event(_before_ctx){% else %}run_crud_event_sync(_before_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("update", return_data))

            result = {% if is_async %}await self._client._rpc({% else %}self._client._sync_rpc({% endif %}"query.update", _payload)
            if not return_data:
                _decoded = result.get("count", 0)
            else:
                _decoded = [_{{ table_name }}_from_row(row) for row in result.get("data", [])]

            _after_ctx = _{{ snake_name }}_event_context(
                self._client,
                "update",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = {% if is_async %}await run_crud_event(_after_ctx){% else %}run_crud_event_sync(_after_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("update", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _{{ snake_name }}_event_context(
                self._client,
                "update",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            {% if is_async %}await run_crud_event(_error_ctx, handle_stop_propagation=False){% else %}run_crud_event_sync(_error_ctx, handle_stop_propagation=False){% endif %}
            raise
{% endif %}