{%- if not is_view %}
    {% if is_async %}async {% endif %}def update_many(
        self,
        *,
        where: Optional[{{ model_name }}WhereInput] = None,
        data: {{ model_name }}UpdateInput,
    ) -> int:
        """Update every {{ model_name }} record matching ``where``.

        Unlike :meth:`update`, no rows are returned: the engine runs one
        statement without a ``RETURNING`` clause however many rows it touches.

        Args:
            where: Filter conditions. If ``None``, all records are updated.
            data: Fields to update.

        Returns:
            The affected-row count.
        """
        _args: Dict[str, Any] = {"where": where, "data": data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "{{ model_name }}",
            "filter": _process_where_filters(where or {}, _{{ table_name }}_py_to_db),
            "data": _process_create_data(data, _{{ table_name }}_py_to_db),
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _{{ snake_name }}_event_context(
                self._client, "updateMany", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = {% if is_async %}await run_crud_event(_before_ctx){% else %}run_crud_event_sync(_before_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("updateMany"))

            result = {% if is_async %}await self._client._rpc({% else %}self._client._sync_rpc({% endif %}"query.updateMany", _payload)
            _decoded = result.get("count", 0)

            _after_ctx = _{{ snake_name }}_event_context(
                self._client,
                "updateMany",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = {% if is_async %}await run_crud_event(_after_ctx){% else %}run_crud_event_sync(_after_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("updateMany"))
            return _decoded
        except Exception as _error:
            _error_ctx = _{{ snake_name }}_event_context(
                self._client,
                "updateMany",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            {% if is_async %}await run_crud_event(_error_ctx, handle_stop_propagation=False){% else %}run_crud_event_sync(_error_ctx, handle_stop_propagation=False){% endif %}
            raise
{% endif %}

