{%- if not is_view %}
    {% if is_async %}async {% endif %}def delete(
        self,
        *,
        where: {{ model_name }}WhereInput,
        return_data: bool = True,
    ) -> Optional["{{ model_name }}"]:
        """Delete the first {{ model_name }} record matching ``where``.

        Finds the first matching record and deletes it by its primary key.

        Args:
            where: Filter conditions. Required.
            return_data: When ``True`` (default) returns the deleted record.
                Set to ``False`` to skip ``RETURNING`` overhead; ``None`` is
                returned in that case.

        Returns:
            The deleted ``{{ model_name }}`` instance when ``return_data=True``,
            or ``None`` when ``return_data=False``.

        Raises:
            NotFoundError: If no record matches the given filter.
        """
        from ..errors import NotFoundError
        record = {% if is_async %}await {% endif %}self.find_first(where=where)
        if record is None:
            raise NotFoundError(
                f"delete: no {{ model_name }} record found matching the given filter"
            )
        pk_filter = {
{%- for pk in primary_key_fields %}
            "{{ pk }}": getattr(record, "{{ pk }}"),
{%- endfor %}
        }
        _args: Dict[str, Any] = {"where": where, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "{{ model_name }}",
            "filter": _process_where_filters(pk_filter, _{{ table_name }}_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _{{ snake_name }}_event_context(
                self._client, "delete", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = {% if is_async %}await run_crud_event(_before_ctx){% else %}run_crud_event_sync(_before_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("delete", return_data))

            result = {% if is_async %}await self._client._rpc({% else %}self._client._sync_rpc({% endif %}"query.delete", _payload)
            if return_data:
                data_rows = result.get("data", [])
                if data_rows:
                    _decoded = _{{ table_name }}_from_row(data_rows[0])
                else:
                    _decoded = record
            else:
                _decoded = None

            _after_ctx = _{{ snake_name }}_event_context(
                self._client,
                "delete",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = {% if is_async %}await run_crud_event(_after_ctx){% else %}run_crud_event_sync(_after_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("delete", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _{{ snake_name }}_event_context(
                self._client,
                "delete",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            {% if is_async %}await run_crud_event(_error_ctx, handle_stop_propagation=False){% else %}run_crud_event_sync(_error_ctx, handle_stop_propagation=False){% endif %}
            raise
{% endif %}