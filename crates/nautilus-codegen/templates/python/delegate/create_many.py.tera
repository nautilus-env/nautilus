{%- if not is_view %}
    {% if is_async %}async {% endif %}def create_many(
        self,
        data: List[{{ model_name }}CreateInput],
        *,
        return_data: bool = True,
    ) -> List[{{ model_name }}]:
        """Create multiple {{ model_name }} records in a single batch.

        Args:
            data: List of field-value dicts for the records to create.
            return_data: When ``True`` (default) the created records are returned.
                Set to ``False`` for bulk inserts to skip ``RETURNING`` overhead.

        Returns:
            The list of newly created ``{{ model_name }}`` instances, or an empty
            list when ``return_data=False``.
        """
        _args: Dict[str, Any] = {"data": data, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "{{ model_name }}",
            "data": [_process_create_data(_entry, _{{ table_name }}_py_to_db) for _entry in data],
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _{{ snake_name }}_event_context(
                self._client, "createMany", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = {% if is_async %}await run_crud_event(_before_ctx){% else %}run_crud_event_sync(_before_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("createMany", return_data))

            result = {% if is_async %}await self._client._rpc({% else %}self._client._sync_rpc({% endif %}"query.createMany", _payload)
            _decoded = [] if not return_data else [
                _{{ table_name }}_from_row(row) for row in result.get("data", [])
            ]

            _after_ctx = _{{ snake_name }}_event_context(
                self._client,
                "createMany",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = {% if is_async %}await run_crud_event(_after_ctx){% else %}run_crud_event_sync(_after_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("createMany", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _{{ snake_name }}_event_context(
                self._client,
                "createMany",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            {% if is_async %}await run_crud_event(_error_ctx, handle_stop_propagation=False){% else %}run_crud_event_sync(_error_ctx, handle_stop_propagation=False){% endif %}
            raise
{% endif %}