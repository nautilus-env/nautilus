{%- if not is_view %}
    {% if is_async %}async {% endif %}def create(self, data: {{ model_name }}CreateInput, *, return_data: bool = True) -> Optional[{{ model_name }}]:
        """Create a new {{ model_name }} record.

        Args:
            data: Field values for the new record.
            return_data: When ``True`` (default) the created record is returned.
                Set to ``False`` for fire-and-forget inserts to avoid the
                round-trip overhead of ``RETURNING``.

        Returns:
            The newly created ``{{ model_name }}`` instance, or ``None`` when
            ``return_data=False``.
        """
        _args: Dict[str, Any] = {"data": data, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "{{ model_name }}",
            "data": _process_create_data(data, _{{ table_name }}_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _{{ snake_name }}_event_context(
                self._client, "create", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = {% if is_async %}await run_crud_event(_before_ctx){% else %}run_crud_event_sync(_before_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("create", return_data))

            result = {% if is_async %}await self._client._rpc({% else %}self._client._sync_rpc({% endif %}"query.create", _payload)
            if not return_data:
                _decoded = None
            else:
                data_rows = result.get("data", [])
                if not data_rows:
                    raise RuntimeError("Create operation returned no data")
                _decoded = _{{ table_name }}_from_row(data_rows[0])

            _after_ctx = _{{ snake_name }}_event_context(
                self._client,
                "create",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = {% if is_async %}await run_crud_event(_after_ctx){% else %}run_crud_event_sync(_after_ctx){% endif %}
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("create", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _{{ snake_name }}_event_context(
                self._client,
                "create",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            {% if is_async %}await run_crud_event(_error_ctx, handle_stop_propagation=False){% else %}run_crud_event_sync(_error_ctx, handle_stop_propagation=False){% endif %}
            raise
{% endif %}