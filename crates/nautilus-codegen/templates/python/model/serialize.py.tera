_{{ table_name }}_input_codec = _ModelInputCodec(
    _{{ table_name }}_extension_input_serializers,
    _{{ table_name }}_object_value_db_fields,
)
_serialize_scalar_input = _{{ table_name }}_input_codec.scalar_input
_serialize_filter_input = _{{ table_name }}_input_codec.filter_input
_serialize_nearest_input = _{{ table_name }}_input_codec.nearest_input
_process_create_data = _{{ table_name }}_input_codec.create_data
_process_where_filters = _{{ table_name }}_input_codec.where_filters


def _{{ snake_name }}_event_context(
    client: Any,
    operation: str,
    phase: EventPhase,
    args: Dict[str, Any],
    payload: Dict[str, Any],
    state: Dict[str, Any],
    *,
    result: Any = None,
    error: Optional[BaseException] = None,
) -> CrudEventContext:
    return CrudEventContext(
        db=client,
        model={{ model_name }},
        model_name="{{ model_name }}",
        operation=operation,
        phase=phase,
        args=args,
        payload=payload,
        result=result,
        error=error,
        state=state,
    )


