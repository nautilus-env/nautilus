
_{{ table_name }}_row_map: Dict[str, str] = {
{%- for f in scalar_fields %}
    "{{ table_name }}__{{ f.db_name }}": "{{ f.name }}",
{%- endfor %}
}
_{{ table_name }}_fields: frozenset = frozenset({
{%- for f in scalar_fields %}
    "{{ f.name }}",
{%- endfor %}
})

_{{ table_name }}_scalar_coercers: Dict[str, Any] = {
{%- for f in scalar_fields %}
{%- if f.is_enum and f.is_array %}
    "{{ f.name }}": lambda v: [{{ f.base_type }}(item) for item in v] if isinstance(v, list) else v,
{%- elif f.is_enum %}
    "{{ f.name }}": {{ f.base_type }},
{%- elif f.extension_coercer %}
    "{{ f.name }}": {{ f.extension_coercer }},
{%- elif f.base_type == "bool" %}
    "{{ f.name }}": _coerce_boolean_value,
{%- elif f.base_type == "bytes" %}
    "{{ f.name }}": _coerce_bytes_value,
{%- elif f.base_type == "Decimal" %}
    "{{ f.name }}": _coerce_decimal_value,
{%- elif f.base_type == "UUID" %}
    "{{ f.name }}": _coerce_uuid_value,
{%- elif f.base_type == "datetime" %}
    "{{ f.name }}": _coerce_datetime_value,
{%- endif %}
{%- endfor %}
}

_{{ table_name }}_py_to_db: Dict[str, str] = {
{%- for f in scalar_fields %}
    "{{ f.logical_name }}": "{{ f.db_name }}",
{%- if f.name != f.logical_name %}
    "{{ f.name }}": "{{ f.db_name }}",
{%- endif %}
{%- endfor %}
}
_{{ table_name }}_py_to_logical: Dict[str, str] = {
{%- for f in scalar_fields %}
    "{{ f.logical_name }}": "{{ f.logical_name }}",
{%- if f.name != f.logical_name %}
    "{{ f.name }}": "{{ f.logical_name }}",
{%- endif %}
{%- endfor %}
}
_{{ table_name }}_logical_to_py: Dict[str, str] = {
{%- for f in scalar_fields %}
    "{{ f.logical_name }}": "{{ f.name }}",
{%- endfor %}
}
_{{ table_name }}_object_value_db_fields: frozenset = frozenset({
{%- for db_name in object_value_db_fields %}
    "{{ db_name }}",
{%- endfor %}
})
_{{ table_name }}_extension_input_serializers: Dict[str, Any] = {
{%- for f in scalar_fields %}
{%- if f.extension_input_serializer %}
    "{{ f.logical_name }}": {{ f.extension_input_serializer }},
{%- if f.name != f.logical_name %}
    "{{ f.name }}": {{ f.extension_input_serializer }},
{%- endif %}
{%- endif %}
{%- endfor %}
}


