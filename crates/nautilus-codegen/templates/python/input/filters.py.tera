class IntFieldUpdate(TypedDict, total=False):
    """Atomic update operators for an integer column.

    ``set`` writes the operand as given; the others let the database derive the
    new value from the row's current one, so concurrent updates do not overwrite
    each other. Name one operator at a time.
    """
    set: NotRequired[int]
    increment: NotRequired[int]
    decrement: NotRequired[int]
    multiply: NotRequired[int]
    divide: NotRequired[int]


class FloatFieldUpdate(TypedDict, total=False):
    """Atomic update operators for a float column. See :class:`IntFieldUpdate`."""
    set: NotRequired[float]
    increment: NotRequired[float]
    decrement: NotRequired[float]
    multiply: NotRequired[float]
    divide: NotRequired[float]


class DecimalFieldUpdate(TypedDict, total=False):
    """Atomic update operators for a decimal column. See :class:`IntFieldUpdate`."""
    set: NotRequired[Decimal]
    increment: NotRequired[Decimal]
    decrement: NotRequired[Decimal]
    multiply: NotRequired[Decimal]
    divide: NotRequired[Decimal]


class StringFilter(TypedDict, total=False):
    """String field filter operations."""
    equals: NotRequired[str]
    not_: NotRequired[str]
    contains: NotRequired[str]
    startswith: NotRequired[str]
    endswith: NotRequired[str]
    in_: NotRequired[List[str]]
    not_in: NotRequired[List[str]]
    is_null: NotRequired[bool]


