export class {{ delegate_name }} {
  constructor(client) {
    this.client = client;
  }

  /**
   * Fetch every matching row and resolve a final in-memory array.
   *
   * Prefer this for small or medium result sets, eager-loaded reads, and any
   * downstream path that already wants the whole collection before continuing.
   */
  async findMany(args) {
    const request = {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args: _{{ model_name }}ReadArgs(args),
    };
    if (args?.chunkSize != null) request['chunkSize'] = args.chunkSize;
    const result = await this.client._rpc('query.findMany', request);
    return ((result['data']) ?? []).map(r => _coerce{{ model_name }}(r));
  }

  /**
   * Yield matching rows incrementally as an async iterable.
   *
   * Prefer this for exports, scans, and `for await ... of` pipelines where
   * keeping client memory flatter matters more than receiving one final array.
   * The underlying request keeps a pooled connection busy until iteration
   * finishes or the iterable is closed.
   */
  async *streamMany(args) {
    const chunkSize = args?.chunkSize ?? 128;
    if (!Number.isInteger(chunkSize) || chunkSize < 1) {
      throw new RangeError('streamMany chunkSize must be a positive integer');
    }

    const rpcArgs = {};
    if (args?.where    != null) rpcArgs['where']   = _processWhereFilters(args.where, _{{ table_name }}FieldToDb);
    if (args?.orderBy  != null) {
      const ob = args.orderBy;
      rpcArgs['orderBy'] = Array.isArray(ob) ? ob : [ob];
    }
{%- if has_vector_fields %}
    if (args?.nearest  != null) rpcArgs['nearest'] = _serializeNearestInput(args.nearest);
{%- endif %}
    if (args?.take     != null) rpcArgs['take']    = args.take;
    if (args?.skip     != null) rpcArgs['skip']    = args.skip;
    if (args?.select   != null) rpcArgs['select']  = args.select;
    if (args?.include  != null) rpcArgs['include'] = _serialize{{ model_name }}Include(args.include);
    if (args?.cursor   != null) rpcArgs['cursor']  = args.cursor;
    if (args?.distinct != null) rpcArgs['distinct'] = args.distinct;

    const payload = {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args: rpcArgs,
      chunkSize,
    };

    for await (const chunk of this.client._streamRpc('query.findMany', payload)) {
      const rows = chunk?.['data'];
      if (!Array.isArray(rows)) continue;
      for (const row of rows) {
        yield _coerce{{ model_name }}(row);
      }
    }
  }

  async findFirst(args) {
    const rpcArgs = {};
    if (args?.where    != null) rpcArgs['where']   = _processWhereFilters(args.where, _{{ table_name }}FieldToDb);
    if (args?.orderBy  != null) {
      const ob = args.orderBy;
      rpcArgs['orderBy'] = Array.isArray(ob) ? ob : [ob];
    }
{%- if has_vector_fields %}
    if (args?.nearest  != null) rpcArgs['nearest'] = _serializeNearestInput(args.nearest);
{%- endif %}
    rpcArgs['take'] = 1;
    if (args?.select   != null) rpcArgs['select']  = args.select;
    if (args?.include  != null) rpcArgs['include'] = _serialize{{ model_name }}Include(args.include);
    const request = {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args: rpcArgs,
    };
    const result = await this.client._rpc('query.findFirst', request);
    const row = _firstDataRow(result);
    return row == null ? null : _coerce{{ model_name }}(row);
  }

  async findUnique(args) {
    if (args.select != null || args.include != null) {
      return this.findFirst({ where: args.where, select: args.select, include: args.include });
    }
    const request = {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      filter: _processWhereFilters(args.where, _{{ table_name }}FieldToDb),
    };
    const result = await this.client._rpc('query.findUnique', request);
    const row = _firstDataRow(result);
    return row == null ? null : _coerce{{ model_name }}(row);
  }

  async findUniqueOrThrow(args) {
    const record = await this.findUnique(args);
    if (record == null) throw new NotFoundError('findUniqueOrThrow: no {{ model_name }} record found matching the given filter');
    return record;
  }

  async findFirstOrThrow(args) {
    const record = await this.findFirst(args);
    if (record == null) throw new NotFoundError('findFirstOrThrow: no {{ model_name }} record found matching the given filter');
    return record;
  }

{%- if not is_view %}
  async create(args) {
    const returnData = args.returnData ?? true;
    const eventArgs = { data: args.data, returnData };
    const payload = {
      protocolVersion: PROTOCOL_VERSION,
      model:      '{{ model_name }}',
      data:       _processCreateData(args.data, _{{ table_name }}FieldToDb),
      returnData,
    };
    const state = {};
    try {
      let stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'create', EventPhase.Before, eventArgs, payload, state,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('create', returnData));

      const result = await this.client._rpc('query.create', payload);
      let decoded = null;
      if (returnData) {
        const rows = result['data'];
        if (!rows?.length) throw new Error('create: engine returned no data');
        decoded = _coerce{{ model_name }}(rows[0]);
      }

      stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'create', EventPhase.After, eventArgs, payload, state, decoded,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('create', returnData));
      return decoded;
    } catch (error) {
      await runCrudEvent(
        _{{ model_name }}EventContext(
          this.client, 'create', EventPhase.Error, eventArgs, payload, state, undefined, error,
        ),
        { handleStopPropagation: false },
      );
      throw error;
    }
  }
{% endif %}

{%- if not is_view %}
  async createMany(args) {
    const returnData = args.returnData ?? true;
