      const result = await this.client._rpc(
        returnData ? 'query.delete' : 'query.deleteMany',
        payload,
      );
      const decoded = returnData
        ? ((result['data']) ?? []).map(r => _coerce{{ model_name }}(r))
        : (result['count'] ?? 0);

      stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'deleteMany', EventPhase.After, eventArgs, payload, state, decoded,
