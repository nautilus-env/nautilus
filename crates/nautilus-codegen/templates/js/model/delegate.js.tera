{% endif %}

  async aggregate(args) {
    const rpcArgs = {};
    if (args?.where != null) rpcArgs['where'] = _processWhereFilters(args.where, _{{ table_name }}FieldToDb);
    if (args?.count != null) rpcArgs['count'] = args.count;
{%- if has_numeric_fields %}
    if (args?.avg   != null) rpcArgs['avg']   = args.avg;
    if (args?.sum   != null) rpcArgs['sum']   = args.sum;
{%- endif %}
    if (args?.min   != null) rpcArgs['min']   = args.min;
    if (args?.max   != null) rpcArgs['max']   = args.max;
    const result = await this.client._rpc('query.aggregate', {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args:  rpcArgs,
    });
    return (result['data'] ?? [])[0] ?? {};
  }

  async explain(args) {
    const request = {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args:  _{{ model_name }}ReadArgs(args),
    };
    if (args?.analyze != null) request['analyze'] = args.analyze;
    return await this.client._rpc('query.explain', request);
  }

  async count(args) {
    const rpcArgs = {};
    if (args?.where  != null) rpcArgs['where']  = _processWhereFilters(args.where, _{{ table_name }}FieldToDb);
    if (args?.take   != null) rpcArgs['take']   = args.take;
    if (args?.skip   != null) rpcArgs['skip']   = args.skip;
    if (args?.cursor != null) rpcArgs['cursor'] = args.cursor;
    const result = await this.client._rpc('query.count', {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args:  Object.keys(rpcArgs).length ? rpcArgs : null,
    });
    return result['count'] ?? 0;
  }

  /** Execute a raw SQL string and return result rows as generic objects. */
  async rawQuery(sql) {
    const result = await this.client._rpc('query.rawQuery', {
      protocolVersion: PROTOCOL_VERSION,
      sql,
    });
    return result['data'] ?? [];
  }

  /** Execute a raw prepared-statement query with bound parameters. */
  async rawStmtQuery(sql, params) {
    const result = await this.client._rpc('query.rawStmtQuery', {
      protocolVersion: PROTOCOL_VERSION,
      sql,
      params: params ?? [],
    });
    return result['data'] ?? [];
  }

{%- if not is_view %}
  async upsert(args) {
    const returnData = args.returnData ?? true;
    const result = await this.client._rpc('query.upsert', {
      protocolVersion: PROTOCOL_VERSION,
      model:      '{{ model_name }}',
      filter:     _processWhereFilters((args.where ?? {}), _{{ table_name }}FieldToDb),
      create:     _processCreateData(args.data.create, _{{ table_name }}FieldToDb),
      update:     _processCreateData(args.data.update ?? {}, _{{ table_name }}FieldToDb),
      returnData,
    });
    if (!returnData) return null;
    const rows = result['data'];
    if (!rows?.length) throw new Error('upsert: engine returned no data');
    if (args.include) {
      const included = await this.findMany({ where: args.where, take: 1, include: args.include });
      return included[0] ?? _coerce{{ model_name }}(rows[0]);
    }
    return _coerce{{ model_name }}(rows[0]);
  }
{% endif %}

  async groupBy(args) {
    const rpcArgs = { by: [...args.by] };
    if (args.where  != null) rpcArgs['where']  = _processWhereFilters(args.where, _{{ table_name }}FieldToDb);
    if (args.having != null) rpcArgs['having'] = args.having;
    if (args.take   != null) rpcArgs['take']   = args.take;
    if (args.skip   != null) rpcArgs['skip']   = args.skip;
    if (args.count  != null) rpcArgs['count']  = args.count;
{%- if has_numeric_fields %}
    if (args.avg    != null) rpcArgs['avg']    = args.avg;
    if (args.sum    != null) rpcArgs['sum']    = args.sum;
{%- endif %}
    if (args.min    != null) rpcArgs['min']    = args.min;
    if (args.max    != null) rpcArgs['max']    = args.max;
    if (args.order  != null) {
      const o = args.order;
      rpcArgs['orderBy'] = Array.isArray(o) ? o : [o];
    }
    const result = await this.client._rpc('query.groupBy', {
      protocolVersion: PROTOCOL_VERSION,
      model: '{{ model_name }}',
      args:  rpcArgs,
    });
    return result['data'] ?? [];
  }
}
