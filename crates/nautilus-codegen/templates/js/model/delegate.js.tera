    const payload = {
      protocolVersion: PROTOCOL_VERSION,
      model:      '{{ model_name }}',
      data:       args.data.map(d => _processCreateData(d, _{{ table_name }}FieldToDb)),
      returnData,
    };
    const state = {};
    try {
      let stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'createMany', EventPhase.Before, eventArgs, payload, state,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('createMany', returnData));

      const result = await this.client._rpc('query.createMany', payload);
      const decoded = returnData
        ? ((result['data']) ?? []).map(r => _coerce{{ model_name }}(r))
        : [];

      stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'createMany', EventPhase.After, eventArgs, payload, state, decoded,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('createMany', returnData));
      return decoded;
    } catch (error) {
      await runCrudEvent(
        _{{ model_name }}EventContext(
          this.client, 'createMany', EventPhase.Error, eventArgs, payload, state, undefined, error,
