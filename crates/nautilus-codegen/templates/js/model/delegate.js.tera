        { handleStopPropagation: false },
      );
      throw error;
    }
  }
{% endif %}

{%- if not is_view %}
  async update(args) {
    const returnData = args.returnData ?? true;
    const eventArgs = { where: args.where, data: args.data, returnData };
    const payload = {
      protocolVersion: PROTOCOL_VERSION,
      model:      '{{ model_name }}',
      filter:     _processWhereFilters((args.where ?? {}), _{{ table_name }}FieldToDb),
      data:       _processCreateData(args.data, _{{ table_name }}FieldToDb),
      returnData,
    };
    const state = {};
    try {
      let stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'update', EventPhase.Before, eventArgs, payload, state,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('update', returnData));

      const result = await this.client._rpc('query.update', payload);
      const decoded = returnData
        ? ((result['data']) ?? []).map(r => _coerce{{ model_name }}(r))
        : (result['count'] ?? 0);

      stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'update', EventPhase.After, eventArgs, payload, state, decoded,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('update', returnData));
      return decoded;
    } catch (error) {
      await runCrudEvent(
        _{{ model_name }}EventContext(
          this.client, 'update', EventPhase.Error, eventArgs, payload, state, undefined, error,
        ),
        { handleStopPropagation: false },
      );
      throw error;
    }
  }
{% endif %}

{%- if not is_view %}
  async delete(args) {
    const record = await this.findFirst({ where: args.where });
    if (record == null) throw new NotFoundError('delete: no {{ model_name }} record found matching the given filter');
    const pkFilter = {
{%- for pk in primary_key_fields %}
      '{{ pk }}': record['{{ pk }}'],
{%- endfor %}
    };
    const returnData = args.returnData ?? true;
    const eventArgs = { where: args.where, returnData };
    const payload = {
      protocolVersion: PROTOCOL_VERSION,
      model:      '{{ model_name }}',
      filter:     _processWhereFilters(pkFilter, _{{ table_name }}FieldToDb),
      returnData,
    };
    const state = {};
    try {
      let stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'delete', EventPhase.Before, eventArgs, payload, state,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('delete', returnData));

      const result = await this.client._rpc('query.delete', payload);
      let decoded = null;
      if (returnData) {
        const rows = result['data'];
        decoded = rows?.length ? _coerce{{ model_name }}(rows[0]) : record;
      }

      stop = await runCrudEvent(_{{ model_name }}EventContext(
        this.client, 'delete', EventPhase.After, eventArgs, payload, state, decoded,
      ));
      if (stop) return resolveStopResult(stop, defaultCrudResult('delete', returnData));
      return decoded;
    } catch (error) {
      await runCrudEvent(
        _{{ model_name }}EventContext(
          this.client, 'delete', EventPhase.Error, eventArgs, payload, state, undefined, error,
        ),
        { handleStopPropagation: false },
      );
      throw error;
    }
  }
{% endif %}

{%- if not is_view %}
  async deleteMany(args) {
    const returnData = args?.returnData ?? false;
    const eventArgs = { where: args?.where, returnData };
    const payload = {
      protocolVersion: PROTOCOL_VERSION,
      model:      '{{ model_name }}',
