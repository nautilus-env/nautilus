{%- endif %}
        let filter = match args.where_.as_ref() {
            Some(filter) => serialize_update_filter_for_engine(Some(filter))?
                .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new())),
            None => serde_json::Value::Object(serde_json::Map::new()),
        };
        if let Some(count) =
            crate::runtime::try_delete_many_via_engine(
                {% if is_async %}&self.client{% else %}&_c{% endif %},
                "{{ model_name }}",
                filter,
            )
            .await?
        {
            return Ok(count);
        }

        Err(nautilus_core::Error::InvalidQuery(
