{%- for nested in nested_writes %}
/// Nested writes on the `{{ nested.field_name }}` relation of {{ model_name }},
/// as accepted by `{{ model_name }}CreateInput`.
///
/// Every operation runs inside the same transaction as the {{ model_name }}
/// write, so a failing child rolls the parent back.
#[derive(Debug, Default, Clone)]
pub struct {{ nested.create_nested_name }} {
{%- if nested.is_owning %}
    /// Create the related {{ nested.target_model }} and point at it.
    pub create: Option<Box<{{ nested.target_create_input }}>>,
    /// Point at the existing {{ nested.target_model }} the filter matches.
    pub connect: Option<nautilus_core::Expr>,
    /// Point at the matched {{ nested.target_model }}, creating it when there is none.
    pub connect_or_create: Option<Box<crate::ConnectOrCreate<{{ nested.target_create_input }}>>>,
{%- else %}
    /// Create these {{ nested.target_model }} records pointing at the parent.
    pub create: Vec<{{ nested.target_create_input }}>,
    /// Same as `create`, spelled the way the batch operation is.
    pub create_many: Vec<{{ nested.target_create_input }}>,
    /// Point the matched {{ nested.target_model }} records at the parent.
    pub connect: Vec<nautilus_core::Expr>,
    /// Connect each matched {{ nested.target_model }}, creating it when there is none.
    pub connect_or_create: Vec<crate::ConnectOrCreate<{{ nested.target_create_input }}>>,
{%- endif %}
}

impl {{ nested.create_nested_name }} {
    fn is_empty(&self) -> bool {
{%- if nested.is_owning %}
        self.create.is_none() && self.connect.is_none() && self.connect_or_create.is_none()
{%- else %}
        self.create.is_empty()
            && self.create_many.is_empty()
            && self.connect.is_empty()
            && self.connect_or_create.is_empty()
{%- endif %}
    }

    fn to_engine_data(&self) -> nautilus_core::Result<serde_json::Value> {
        let mut operations = serde_json::Map::new();
{%- if nested.is_owning %}
        if let Some(create) = &self.create {
            operations.insert("create".to_string(), crate::runtime::nested::input_json(create.as_ref())?);
        }
        if let Some(filter) = &self.connect {
            operations.insert("connect".to_string(), crate::runtime::nested::filter_json(filter)?);
        }
        if let Some(entry) = &self.connect_or_create {
            operations.insert(
                "connectOrCreate".to_string(),
                crate::runtime::nested::entry_json(entry.as_ref())?,
            );
        }
{%- else %}
        if !self.create.is_empty() {
            operations.insert("create".to_string(), crate::runtime::nested::data_array(&self.create)?);
        }
        if !self.create_many.is_empty() {
            operations.insert(
                "createMany".to_string(),
                serde_json::json!({ "data": crate::runtime::nested::data_array(&self.create_many)? }),
            );
        }
        if !self.connect.is_empty() {
            operations.insert(
                "connect".to_string(),
                crate::runtime::nested::filter_array(&self.connect)?,
            );
        }
        if !self.connect_or_create.is_empty() {
            operations.insert(
                "connectOrCreate".to_string(),
                crate::runtime::nested::entry_array(&self.connect_or_create)?,
            );
        }
{%- endif %}
        Ok(serde_json::Value::Object(operations))
    }
}

/// Nested writes on the `{{ nested.field_name }}` relation of {{ model_name }},
/// as accepted by `{{ model_name }}UpdateInput`.
///
/// Removals run before additions, so a `set` clears the relation before
/// `connect` fills it again.
#[derive(Debug, Default, Clone)]
pub struct {{ nested.update_nested_name }} {
{%- if nested.is_owning %}
    /// Create the related {{ nested.target_model }} and point at it.
    pub create: Option<Box<{{ nested.target_create_input }}>>,
    /// Point at the existing {{ nested.target_model }} the filter matches.
    pub connect: Option<nautilus_core::Expr>,
    /// Point at the matched {{ nested.target_model }}, creating it when there is none.
    pub connect_or_create: Option<Box<crate::ConnectOrCreate<{{ nested.target_create_input }}>>>,
    /// Clear the foreign key without touching the related record.
    pub disconnect: bool,
    /// Update the {{ nested.target_model }} the foreign key currently points at.
    pub update: Option<Box<{{ nested.target_update_input }}>>,
    /// Clear the foreign key and delete the record it pointed at.
    pub delete: bool,
{%- else %}
    /// Create these {{ nested.target_model }} records pointing at the parent.
    pub create: Vec<{{ nested.target_create_input }}>,
    /// Same as `create`, spelled the way the batch operation is.
    pub create_many: Vec<{{ nested.target_create_input }}>,
    /// Point the matched {{ nested.target_model }} records at the parent.
    pub connect: Vec<nautilus_core::Expr>,
    /// Connect each matched {{ nested.target_model }}, creating it when there is none.
    pub connect_or_create: Vec<crate::ConnectOrCreate<{{ nested.target_create_input }}>>,
    /// Detach the matched records from the parent.
    pub disconnect: Vec<nautilus_core::Expr>,
    /// Replace the members of the relation with the matched records.
    pub set: Vec<nautilus_core::Expr>,
    /// Update one connected record per entry; an entry matching none fails.
    pub update: Vec<crate::NestedUpdate<{{ nested.target_update_input }}>>,
    /// Update every connected record the filter of the entry narrows to.
    pub update_many: Vec<crate::NestedUpdate<{{ nested.target_update_input }}>>,
    /// Delete one connected record per filter; a filter matching none fails.
    pub delete: Vec<nautilus_core::Expr>,
    /// Delete every connected record the filter narrows to.
    pub delete_many: Vec<nautilus_core::Expr>,
{%- endif %}
}

impl {{ nested.update_nested_name }} {
    fn is_empty(&self) -> bool {
{%- if nested.is_owning %}
        self.create.is_none()
            && self.connect.is_none()
            && self.connect_or_create.is_none()
            && !self.disconnect
            && self.update.is_none()
            && !self.delete
{%- else %}
        self.create.is_empty()
            && self.create_many.is_empty()
            && self.connect.is_empty()
            && self.connect_or_create.is_empty()
            && self.disconnect.is_empty()
            && self.set.is_empty()
            && self.update.is_empty()
            && self.update_many.is_empty()
            && self.delete.is_empty()
            && self.delete_many.is_empty()
{%- endif %}
    }

    fn to_engine_data(&self) -> nautilus_core::Result<serde_json::Value> {
        let mut operations = serde_json::Map::new();
{%- if nested.is_owning %}
        if let Some(create) = &self.create {
            operations.insert("create".to_string(), crate::runtime::nested::input_json(create.as_ref())?);
        }
        if let Some(filter) = &self.connect {
            operations.insert("connect".to_string(), crate::runtime::nested::filter_json(filter)?);
        }
        if let Some(entry) = &self.connect_or_create {
            operations.insert(
                "connectOrCreate".to_string(),
                crate::runtime::nested::entry_json(entry.as_ref())?,
            );
        }
        if self.disconnect {
            operations.insert("disconnect".to_string(), serde_json::Value::Bool(true));
        }
        if let Some(update) = &self.update {
            operations.insert("update".to_string(), crate::runtime::nested::input_json(update.as_ref())?);
        }
        if self.delete {
            operations.insert("delete".to_string(), serde_json::Value::Bool(true));
        }
{%- else %}
        if !self.create.is_empty() {
            operations.insert("create".to_string(), crate::runtime::nested::data_array(&self.create)?);
        }
        if !self.create_many.is_empty() {
            operations.insert(
                "createMany".to_string(),
                serde_json::json!({ "data": crate::runtime::nested::data_array(&self.create_many)? }),
            );
        }
        if !self.connect.is_empty() {
            operations.insert(
                "connect".to_string(),
                crate::runtime::nested::filter_array(&self.connect)?,
            );
        }
        if !self.connect_or_create.is_empty() {
            operations.insert(
                "connectOrCreate".to_string(),
                crate::runtime::nested::entry_array(&self.connect_or_create)?,
            );
        }
        if !self.disconnect.is_empty() {
            operations.insert(
                "disconnect".to_string(),
                crate::runtime::nested::filter_array(&self.disconnect)?,
            );
        }
        if !self.set.is_empty() {
            operations.insert("set".to_string(), crate::runtime::nested::filter_array(&self.set)?);
        }
        if !self.update.is_empty() {
            operations.insert("update".to_string(), crate::runtime::nested::entry_array(&self.update)?);
        }
        if !self.update_many.is_empty() {
            operations.insert(
                "updateMany".to_string(),
                crate::runtime::nested::entry_array(&self.update_many)?,
            );
        }
        if !self.delete.is_empty() {
            operations.insert("delete".to_string(), crate::runtime::nested::filter_array(&self.delete)?);
        }
        if !self.delete_many.is_empty() {
            operations.insert(
                "deleteMany".to_string(),
                crate::runtime::nested::filter_array(&self.delete_many)?,
            );
        }
{%- endif %}
        Ok(serde_json::Value::Object(operations))
    }
}

{% endfor %}