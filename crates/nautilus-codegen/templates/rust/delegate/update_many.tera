{%- if not is_view %}
    /// Update every {{ model_name }} record matching `args.where_`, returning
    /// the affected-row count.
    ///
    /// Unlike [`Self::update`], no rows are read back: the engine runs one
    /// statement without a `RETURNING` clause however many rows it touches.
    pub {% if is_async %}async {% endif %}fn update_many(
        &self,
        args: {{ model_name }}UpdateArgs,
    ) -> nautilus_core::Result<u64> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = args.clone();
        let filter = serialize_update_filter_for_engine(args.where_.as_ref())?
            .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new()));
        let _event_data = args.data.to_engine_data()?;
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            _payload.insert("filter".to_string(), filter.clone());
            _payload.insert("data".to_string(), _event_data.clone());
            serde_json::Value::Object(_payload)
        };
        crate::events::run_with_crud_events(
            &_events,
            "{{ model_name }}",
            crate::CrudOperation::UpdateMany,
            _transaction_id,
            _event_args,
            _event_payload,
            || async move {
                crate::runtime::update_many_via_engine(
                    {% if is_async %}&self.client{% else %}&_c{% endif %},
                    "{{ model_name }}",
                    filter,
                    _event_data,
                )
                .await
            },
        )
        .await
{%- if not is_async %}
        }))
{%- endif %}
    }
{% endif %}