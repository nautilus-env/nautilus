{%- if not is_view %}
    /// Delete the first {{ model_name }} record matching `args.where_`.
    ///
    /// finds the first matching record and
    /// deletes it by its primary key. Returns `Ok(None)` if no record matches.
    pub {% if is_async %}async {% endif %}fn delete(
        &self,
        args: {{ model_name }}DeleteArgs,
    ) -> nautilus_core::Result<Option<{{ model_name }}>> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = args.clone();
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            let _filter = match args.where_.as_ref() {
                Some(filter) => serialize_update_filter_for_engine(Some(filter))?
                    .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new())),
                None => serde_json::Value::Object(serde_json::Map::new()),
            };
            _payload.insert("filter".to_string(), _filter);
            serde_json::Value::Object(_payload)
        };
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = {{ model_name }}DeleteEventContext::new(
            "{{ model_name }}",
            crate::CrudOperation::Delete,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<{{ model_name }}DeleteEventContext, Option<{{ model_name }}>>(
            "{{ model_name }}",
            crate::CrudOperation::Delete,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Option<{{ model_name }}>> = async {
            if let Some(filter) = args.where_.clone() {
                if {% if is_async %}self.client{% else %}_c{% endif %}.dialect().supports_returning() && is_single_record_filter(&filter) {
                    let deleted = {{ delete_name }}::new({% if is_async %}self.client.clone(){% else %}_c.clone(){% endif %}).where_(filter).exec().await?;
                    return match deleted.len() {
                        0 => Ok(None),
                        1 => Ok(deleted.into_iter().next()),
                        count => Err(nautilus_core::Error::Other(format!(
                            "expected at most one deleted {{ model_name }} row, got {}",
                            count
                        ))),
                    };
                }
            }

            // Find the first matching record to get its primary key
            let record = self.find_first(nautilus_core::FindManyArgs {
                where_: args.where_,
                ..Default::default()
            }){% if is_async %}.await{% endif %}?;

            let Some(record) = record else {
                return Ok(None);
            };

            // Build a primary-key filter to delete exactly that one record
            {%- set pk_fields = scalar_fields | filter(attribute="is_pk", value=true) %}
            let pk_filter = {% for f in pk_fields %}{% if not loop.first %}.and({% endif %}nautilus_core::Expr::column("{{ table_name }}__{{ f.db_name }}").eq(nautilus_core::Expr::param(record.{{ f.name }}.clone())){% if not loop.first %}){% endif %}{% endfor %};
            {{ delete_name }}::new({% if is_async %}self.client.clone(){% else %}_c.clone(){% endif %}).where_(pk_filter).exec().await?;
            Ok(Some(record))
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = {{ model_name }}DeleteEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<{{ model_name }}DeleteEventContext, Option<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = {{ model_name }}DeleteEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<{{ model_name }}DeleteEventContext, Option<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
{%- if not is_async %}
        }))
{%- else %}
{%- endif %}
    }
{% endif %}