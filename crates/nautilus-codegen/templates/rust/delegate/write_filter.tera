{%- if not is_view %}
use crate::runtime::serialize_update_filter_for_engine;

fn single_record_filter_field_name(column: &str) -> Option<&'static str> {
{%- for field in scalar_fields %}
    if column == "{{ table_name }}__{{ field.db_name }}"
        || column == "{{ field.db_name }}"
{%- if field.logical_name != field.db_name %}
        || column == "{{ field.logical_name }}"
{%- endif %}
    {
        return Some("{{ field.name }}");
    }
{%- endfor %}
    None
}

fn is_single_record_filter(filter: &nautilus_core::Expr) -> bool {
    const SINGLE_RECORD_CONSTRAINTS: &[&[&str]] = &[
{%- for constraint in single_record_constraints %}
        &[{% for field in constraint %}"{{ field.name }}"{% if not loop.last %}, {% endif %}{% endfor %}],
{%- endfor %}
    ];

    crate::runtime::is_single_record_filter(
        filter,
        single_record_filter_field_name,
        SINGLE_RECORD_CONSTRAINTS,
    )
}
{% endif %}
