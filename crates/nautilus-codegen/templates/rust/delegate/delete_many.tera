{%- if not is_view %}
    /// Delete all {{ model_name }} records matching `args.where_`.
    ///
    /// If `args.where_` is `None`, all rows are deleted.
    /// Executes immediately and returns the deleted records.
    pub {% if is_async %}async {% endif %}fn delete_many(
        &self,
        args: {{ model_name }}DeleteArgs,
    ) -> nautilus_core::Result<Vec<{{ model_name }}>> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = args.clone();
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            let _filter = match args.where_.as_ref() {
                Some(filter) => serialize_update_filter_for_engine(Some(filter))?
                    .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new())),
                None => serde_json::Value::Object(serde_json::Map::new()),
            };
            _payload.insert("filter".to_string(), _filter);
            serde_json::Value::Object(_payload)
        };
        crate::events::run_with_crud_events(
            &_events,
            "{{ model_name }}",
            crate::CrudOperation::DeleteMany,
            _transaction_id,
            _event_args,
            _event_payload,
            || async move {
                let mut builder = {{ delete_name }}::new({% if is_async %}self.client.clone(){% else %}_c{% endif %});
                if let Some(expr) = args.where_ {
                    builder = builder.where_(expr);
                } else {
                    builder = builder.all();
                }
                builder.exec().await
            },
        )
        .await
{%- if not is_async %}
        }))
{%- endif %}
    }
{% endif %}

