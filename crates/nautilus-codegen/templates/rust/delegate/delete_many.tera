{%- if not is_view %}
    /// Delete all {{ model_name }} records matching `args.where_`.
    ///
    /// If `args.where_` is `None`, all rows are deleted.
    /// Executes immediately and returns the deleted records.
    pub {% if is_async %}async {% endif %}fn delete_many(
        &self,
        args: {{ model_name }}DeleteArgs,
    ) -> nautilus_core::Result<Vec<{{ model_name }}>> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = args.clone();
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            let _filter = match args.where_.as_ref() {
                Some(filter) => serialize_update_filter_for_engine(Some(filter))?
                    .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new())),
                None => serde_json::Value::Object(serde_json::Map::new()),
            };
            _payload.insert("filter".to_string(), _filter);
            serde_json::Value::Object(_payload)
        };
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = {{ model_name }}DeleteManyEventContext::new(
            "{{ model_name }}",
            crate::CrudOperation::DeleteMany,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<{{ model_name }}DeleteManyEventContext, Vec<{{ model_name }}>>(
            "{{ model_name }}",
            crate::CrudOperation::DeleteMany,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Vec<{{ model_name }}>> = async {
            let mut builder = {{ delete_name }}::new({% if is_async %}self.client.clone(){% else %}_c{% endif %});
            if let Some(expr) = args.where_ {
                builder = builder.where_(expr);
            } else {
                builder = builder.all();
            }
            builder.exec().await
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = {{ model_name }}DeleteManyEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::DeleteMany,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<{{ model_name }}DeleteManyEventContext, Vec<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::DeleteMany,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = {{ model_name }}DeleteManyEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::DeleteMany,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<{{ model_name }}DeleteManyEventContext, Vec<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::DeleteMany,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
{%- if not is_async %}
        }))
{%- endif %}
    }
{% endif %}

