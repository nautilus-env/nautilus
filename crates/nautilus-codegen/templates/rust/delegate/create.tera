{%- if not is_view %}
    /// Create a new {{ model_name }} record.
    ///
    /// Executes immediately and returns the created `{{ model_name }}`.
    pub {% if is_async %}async {% endif %}fn create(
        &self,
        data: {{ model_name }}CreateInput,
    ) -> nautilus_core::Result<{{ model_name }}> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = data.clone();
        let _event_payload = data.to_engine_data()?;
        let _engine_data = _event_payload.clone();
        crate::events::run_with_crud_events(
            &_events,
            "{{ model_name }}",
            crate::CrudOperation::Create,
            _transaction_id,
            _event_args,
            _event_payload,
            || async move {
                if let Some(record) =
                    crate::runtime::try_create_via_engine::<_, {{ model_name }}>(
                        {% if is_async %}&self.client{% else %}&_c{% endif %},
                        "{{ model_name }}",
                        _engine_data,
                        data.has_nested_writes(),
                        |row| {
                            decode_model_row_with_hints(
                                row,
                                all_scalar_decode_slots(),
                                all_scalar_value_hints(),
                            )
                        },
                    )
                    .await?
                {
                    Ok(record)
                } else {
                    let mut builder = {{ create_name }}::new({% if is_async %}self.client.clone(){% else %}_c{% endif %});
{%- for field in create_fields %}
                    if let Some(value) = data.{{ field.name }} {
                        builder = builder.{{ field.name }}(value);
                    }
{%- endfor %}
                    builder.exec().await
                }
            },
        )
        .await
{%- if not is_async %}
        }))
{%- endif %}
    }
{% endif %}