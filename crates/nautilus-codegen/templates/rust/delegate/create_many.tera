{%- if not is_view %}
    /// Create multiple {{ model_name }} records in a single batch.
    ///
    /// Executes immediately and returns the created records.
    pub {% if is_async %}async {% endif %}fn create_many(
        &self,
        entries: Vec<{{ entry_name }}>,
    ) -> nautilus_core::Result<Vec<{{ model_name }}>> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = entries.clone();
        let _event_payload = serde_json::Value::Array(
            entries.iter().map({{ entry_name }}::to_engine_data).collect(),
        );
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = {{ model_name }}CreateManyEventContext::new(
            "{{ model_name }}",
            crate::CrudOperation::CreateMany,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<{{ model_name }}CreateManyEventContext, Vec<{{ model_name }}>>(
            "{{ model_name }}",
            crate::CrudOperation::CreateMany,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Vec<{{ model_name }}>> = async {
            if entries.is_empty() {
                return Ok(vec![]);
            }

            if let Some(rows) =
                crate::runtime::try_create_many_via_engine::<_, {{ model_name }}>(
                    {% if is_async %}&self.client{% else %}&_c{% endif %},
                    "{{ model_name }}",
                    entries.iter().map({{ entry_name }}::to_engine_data).collect(),
                    |row| {
                        decode_model_row_with_hints(
                            row,
                            all_scalar_decode_slots(),
                            all_scalar_value_hints(),
                        )
                    },
                )
                .await?
            {
                return Ok(rows);
            }

            let mut builder = {{ create_many_name }}::new({% if is_async %}self.client.clone(){% else %}_c{% endif %});
            for entry in entries {
                builder = builder.entry(entry);
            }
            builder.exec().await
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = {{ model_name }}CreateManyEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<{{ model_name }}CreateManyEventContext, Vec<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = {{ model_name }}CreateManyEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<{{ model_name }}CreateManyEventContext, Vec<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
{%- if not is_async %}
        }))
{%- endif %}
    }
{% endif %}