{%- if not is_view %}
    /// Update {{ model_name }} records matching `args.where_`.
    ///
    /// If `args.where_` is `None`, all rows are updated.
    /// Executes immediately and returns the updated records.
    pub {% if is_async %}async {% endif %}fn update(
        &self,
        args: {{ model_name }}UpdateArgs,
    ) -> nautilus_core::Result<Vec<{{ model_name }}>> {
{%- if not is_async %}
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
{%- endif %}
        let _events = {% if is_async %}self.client.events().clone(){% else %}_c.events().clone(){% endif %};
        let _transaction_id = {% if is_async %}self.client.transaction_id(){% else %}_c.transaction_id(){% endif %};
        let _event_args = args.clone();
        let _engine_data = args.data.to_engine_data()?;
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            _payload.insert(
                "filter".to_string(),
                match serialize_update_filter_for_engine(args.where_.as_ref())? {
                    Some(value) => value,
                    None => serde_json::Value::Object(serde_json::Map::new()),
                },
            );
            _payload.insert("data".to_string(), _engine_data.clone());
            serde_json::Value::Object(_payload)
        };
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = {{ model_name }}UpdateEventContext::new(
            "{{ model_name }}",
            crate::CrudOperation::Update,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<{{ model_name }}UpdateEventContext, Vec<{{ model_name }}>>(
            "{{ model_name }}",
            crate::CrudOperation::Update,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Vec<{{ model_name }}>> = async {
            let no_assignments = _engine_data
                .as_object()
                .is_some_and(|data| data.is_empty());
            if no_assignments {
                return Ok(vec![]);
            }

            if let Some(filter_json) = serialize_update_filter_for_engine(args.where_.as_ref())? {
                if let Some(rows) =
                    crate::runtime::try_update_via_engine::<_, {{ model_name }}>(
                        {% if is_async %}&self.client{% else %}&_c{% endif %},
                        "{{ model_name }}",
                        filter_json,
                        _engine_data.clone(),
                        args.data.has_nested_writes(),
                        |row| {
                            decode_model_row_with_hints(
                                row,
                                all_scalar_decode_slots(),
                                all_scalar_value_hints(),
                            )
                        },
                    )
                    .await?
                {
                    return Ok(rows);
                }
            }

            if args.data.has_nested_writes() {
                return Err(crate::runtime::nested::writes_need_engine("{{ model_name }}"));
            }

            let mut builder = {{ update_name }}::new({% if is_async %}self.client.clone(){% else %}_c{% endif %}).set_data(args.data);
            if let Some(filter) = args.where_ {
                builder = builder.where_(filter);
            } else {
                builder = builder.all();
            }
            builder.exec().await
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = {{ model_name }}UpdateEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::Update,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<{{ model_name }}UpdateEventContext, Vec<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::Update,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = {{ model_name }}UpdateEventContext::new(
                    "{{ model_name }}",
                    crate::CrudOperation::Update,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<{{ model_name }}UpdateEventContext, Vec<{{ model_name }}>>(
                    "{{ model_name }}",
                    crate::CrudOperation::Update,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
{%- if not is_async %}
        }))
{%- endif %}
    }
{% endif %}