impl {{ model_name }} {
{%- for field in scalar_fields %}
    /// Column accessor for {{ field.name }}.
    pub fn {{ field.name }}() -> nautilus_core::Column<{{ field.column_type }}> {
        nautilus_core::Column::new("{{ table_name }}", "{{ field.db_name }}")
    }

{%- endfor %}
{%- for vector in vector_fields %}
    /// Build a pgvector nearest-neighbor search against {{ vector.name }}.
    ///
    /// Pass the result as `FindManyArgs::nearest` together with a positive
    /// `take`: the query then returns the closest rows by `metric`, which
    /// should match the opclass of the vector index to stay index-backed.
    pub fn {{ vector.name }}_nearest(
        query: Vec<f32>,
        metric: nautilus_core::VectorMetric,
    ) -> nautilus_core::VectorNearest {
        nautilus_core::VectorNearest {
            field: "{{ vector.logical_name }}".to_string(),
            query,
            metric,
        }
    }

{%- endfor %}
{%- for field in nested_order_by_fields %}
    /// Order accessor for {{ field.path }}.
    pub fn {{ field.method_name }}() -> nautilus_core::OrderField<{{ field.rust_type }}> {
        nautilus_core::OrderField::new("{{ table_name }}", "{{ field.path }}")
    }

{%- endfor %}
    /// Create a delegate for {{ model_name }} queries.
    pub fn nautilus<E>(client: &crate::Client<E>) -> {{ delegate_name }}<E>
    where
        E: crate::Executor,
        for<'a> E::Row<'a>: Into<crate::Row>,
    {
        {{ delegate_name }}::new(client.clone())
    }
}
