    /**
     * Aggregate over every {{ model_name }} row matching {@code where}, without a
     * grouping key.
     *
     * <p>Always resolves to one object, even when the filter matches nothing:
     * counts are then {@code 0} and the other aggregates {@code null}.
     */
    public CompletableFuture<JsonNode> aggregate(Consumer<{{ dsl_name }}.AggregateArgs> spec) {
        return async(() -> {
            {{ dsl_name }}.AggregateArgs args = new {{ dsl_name }}.AggregateArgs();
            if (spec != null) {
                spec.accept(args);
            }
            return aggregateInternal(args);
        });
    }

    /**
     * Ask the database to explain the statement {@link #findMany} would run.
     *
     * <p>Relations loaded through {@code include} are separate statements and are
     * not part of the reported plan.
