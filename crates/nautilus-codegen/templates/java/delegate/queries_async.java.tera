    public CompletableFuture<JsonNode> explain(Consumer<{{ dsl_name }}.ExplainArgs> spec) {
        return async(() -> {
            {{ dsl_name }}.ExplainArgs args = new {{ dsl_name }}.ExplainArgs();
            if (spec != null) {
                spec.accept(args);
            }
            return explainInternal(args);
        });
    }

