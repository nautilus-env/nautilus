    }
{% endif %}

{%- if not is_view %}
    public CompletableFuture<Long> deleteMany(Consumer<{{ dsl_name }}.DeleteArgs> spec) {
        return async(() -> {
            {{ dsl_name }}.DeleteArgs args = new {{ dsl_name }}.DeleteArgs();
            if (spec != null) {
                spec.accept(args);
            }
            return deleteManyInternal(args);
        });
    }
{% endif %}

{%- if not is_view %}
    /**
     * Update every {{ model_name }} row matching {@code where}, resolving to the
     * affected-row count.
     *
     * <p>Unlike {@link #update}, no rows are returned: the engine runs one
     * statement without a {@code RETURNING} clause however many rows it touches.
     */
    public CompletableFuture<Long> updateMany(Consumer<{{ dsl_name }}.UpdateArgs> spec) {
        return async(() -> {
            {{ dsl_name }}.UpdateArgs args = new {{ dsl_name }}.UpdateArgs();
            if (spec != null) {
                spec.accept(args);
            }
            return updateManyInternal(args);
        });
    }
{% endif %}

