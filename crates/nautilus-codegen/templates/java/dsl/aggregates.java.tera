    public static final class ExplainArgs implements WireSerializable {
        private final ObjectNode node = JsonSupport.object();
        private boolean analyze;

        public ExplainArgs where(Consumer<Where> spec) {
            Where builder = new Where();
            if (spec != null) {
                spec.accept(builder);
            }
            this.node.set("where", builder.node());
            return this;
        }

        public ExplainArgs orderBy(Consumer<OrderBy> spec) {
            OrderBy builder = new OrderBy();
            if (spec != null) {
                spec.accept(builder);
            }
            ArrayNode values = this.node.has("orderBy") && this.node.get("orderBy").isArray()
                ? (ArrayNode) this.node.get("orderBy")
                : JsonSupport.array();
            values.add(builder.node());
            this.node.set("orderBy", values);
            return this;
        }

        public ExplainArgs take(int value) {
            this.node.put("take", value);
            return this;
        }

        public ExplainArgs skip(int value) {
            this.node.put("skip", value);
            return this;
        }

        /** Execute the statement to collect real timings, where the backend supports it. */
        public ExplainArgs analyze(boolean value) {
            this.analyze = value;
            return this;
        }

        public boolean analyzeFlag() {
            return this.analyze;
        }

{% include "dsl/serializable_tail.java.tera" %}
    }

    public static final class GroupByArgs implements WireSerializable {
        private final ObjectNode node = JsonSupport.object();

        public GroupByArgs by(ScalarField... fields) {
            ArrayNode values = JsonSupport.array();
            for (ScalarField field : fields) {
                values.add(field.wireName());
            }
            this.node.set("by", values);
            return this;
        }

        public GroupByArgs where(Consumer<Where> spec) {
            Where builder = new Where();
            if (spec != null) {
                spec.accept(builder);
            }
            this.node.set("where", builder.node());
            return this;
        }

        public GroupByArgs having(JsonNode having) {
            this.node.set("having", JsonSupport.toJsonNode(having));
            return this;
        }

        public GroupByArgs take(int value) {
            this.node.put("take", value);
            return this;
        }

        public GroupByArgs skip(int value) {
            this.node.put("skip", value);
            return this;
        }

        public GroupByArgs count(Consumer<CountAggregate> spec) {
