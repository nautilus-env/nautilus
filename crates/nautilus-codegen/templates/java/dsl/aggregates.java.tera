    public static final class AggregateArgs implements WireSerializable {
        private final ObjectNode node = JsonSupport.object();

        public AggregateArgs where(Consumer<Where> spec) {
            Where builder = new Where();
            if (spec != null) {
                spec.accept(builder);
            }
            this.node.set("where", builder.node());
            return this;
        }

        public AggregateArgs count(Consumer<CountAggregate> spec) {
            CountAggregate builder = new CountAggregate();
            if (spec != null) {
                spec.accept(builder);
            }
            this.node.set("count", builder.node());
