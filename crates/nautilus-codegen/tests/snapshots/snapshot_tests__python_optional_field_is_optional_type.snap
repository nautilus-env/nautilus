def _post_event_context(
    client: Any,
    operation: str,
    phase: EventPhase,
    args: Dict[str, Any],
    payload: Dict[str, Any],
    state: Dict[str, Any],
    *,
    result: Any = None,
    error: Optional[BaseException] = None,
) -> CrudEventContext:
    return CrudEventContext(
        db=client,
        model=Post,
        model_name="Post",
        operation=operation,
        phase=phase,
        args=args,
        payload=payload,
        result=result,
        error=error,
        state=state,
    )


def _serialize_post_include_args(spec: Any) -> Any:
    """Prepare one include node, which loads Post under a parent."""
    return _serialize_include_args(
        spec,
        _process_where_filters,
        _Post_py_to_db,
        _serialize_post_include,
    )


def _serialize_post_include(include: Any) -> Any:
    """Prepare the relations Post eager-loads, each against its own model."""
    if include is None or isinstance(include, bool):
        return include
    if not isinstance(include, dict):
        return include
    result: Dict[str, Any] = {}
    for field, spec in include.items():
        result[field] = spec
    return result


def _coerce_post_scalar(py_key: str, value: Any) -> Any:
    if py_key in _Post_scalar_coercers:
        return _Post_scalar_coercers[py_key](value)
    return value


def _hydrate_post_relation(field_name: str, value: Any) -> Any:
    return value


def _post_from_wire(row: Dict[str, Any]) -> "Post":
    """Convert engine rows and nested include payloads to Post."""
    kwargs: Dict[str, Any] = {}
    value = _get_wire_value(row, "Post__id", "id")
    if value is not _MISSING:
        if value is not None:
            kwargs["id"] = _coerce_post_scalar("id", value)
    value = _get_wire_value(row, "Post__title", "title")
    if value is not _MISSING:
        if value is not None:
            kwargs["title"] = _coerce_post_scalar("title", value)
    value = _get_wire_value(row, "Post__content", "content")
    if value is not _MISSING:
        if value is not None:
            kwargs["content"] = _coerce_post_scalar("content", value)
    return Post(**kwargs)


def _post_projection_from_wire(row: Dict[str, Any]) -> "PostProjection":
    """Convert engine rows to a partial Post projection."""
    payload: Any = {}
    value = _get_wire_value(row, "Post__id", "id")
    if value is not _MISSING:
        payload["id"] = (
            _coerce_post_scalar("id", value)
            if value is not None
            else None
        )
    value = _get_wire_value(row, "Post__title", "title")
    if value is not _MISSING:
        payload["title"] = (
            _coerce_post_scalar("title", value)
            if value is not None
            else None
        )
    value = _get_wire_value(row, "Post__content", "content")
    if value is not _MISSING:
        payload["content"] = (
            _coerce_post_scalar("content", value)
            if value is not None
            else None
        )
    return payload


def _Post_from_row(row: Dict[str, Any]) -> "Post":
    """Convert engine row (table__column keys) to Post dataclass."""
    return _post_from_wire(row)


def _post_from_row(row: Dict[str, Any]) -> "Post":
    """Compatibility wrapper keyed by model snake_case."""
    return _post_from_wire(row)


class PostDelegate:
    """Operations for Post.
    Every method executes synchronously — no ``await`` or event loop needed::

        users = client.Post.find_many(where={"role": "ADMIN"}, take=10)
        user  = client.Post.create({"email": "alice@example.com"})
    """

    def __init__(self, client: NautilusClient) -> None:
        self._client = client

    @overload
    def find_many(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        take: Optional[int] = None,
        skip: Optional[int] = None,
        select: None = None,
        include: Optional[Dict[str, Any]] = None,
        cursor: Optional[Dict[str, Any]] = None,
        distinct: Optional[List[str]] = None,
        chunk_size: Optional[int] = None,
    ) -> List[Post]: ...

    @overload
    def find_many(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        take: Optional[int] = None,
        skip: Optional[int] = None,
        select: PostSelectInput,
        include: Optional[Dict[str, Any]] = None,
        cursor: Optional[Dict[str, Any]] = None,
        distinct: Optional[List[str]] = None,
        chunk_size: Optional[int] = None,
    ) -> List[PostProjection]: ...

    def find_many(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        take: Optional[int] = None,
        skip: Optional[int] = None,
        select: Optional[PostSelectInput] = None,
        include: Optional[Dict[str, Any]] = None,
        cursor: Optional[Dict[str, Any]] = None,
        distinct: Optional[List[str]] = None,
        chunk_size: Optional[int] = None,
    ) -> Union[List[Post], List[PostProjection]]:
        """Find all Post records matching the given filters.

        Args:
            where: Filter conditions (optional).
            order_by: Sorting directions, e.g. ``{"created_at": "desc"}``.
            take: Maximum number of rows to return (LIMIT).
                  Positive values paginate **forward**; negative values
                  paginate **backward** from the cursor position.
            skip: Number of rows to skip (OFFSET).
            select: Scalar field projection, e.g. ``{"id": True, "display_name": True}``.
                    Primary-key fields are always returned by the engine.
            include: Relations to eager-load, e.g. ``{"posts": True}``.
            cursor: Stable keyset cursor — a dict of primary-key field name
                    to value.  All PK fields of the model must be present.
                    The cursor record is included in the result (inclusive).
            distinct: List of field names to deduplicate on.
                      Postgres: ``SELECT DISTINCT ON (col, ...)`` with the
                      distinct columns auto-prepended to ORDER BY.
                      SQLite / MySQL: plain ``SELECT DISTINCT`` (full-row
                      dedup — most effective combined with ``select``).
            chunk_size: Optional protocol-level row chunk size for large result
                        sets. The client still returns one fully merged list.

        Returns:
            A list of matching ``Post`` instances. Prefer this API
            when the caller naturally wants the whole result set in memory.
        """
        args: Dict[str, Any] = {}
        if where is not None:
            args["where"] = _process_where_filters(where, _Post_py_to_db)
        if order_by is not None:
            if isinstance(order_by, list):
                args["orderBy"] = order_by
            else:
                args["orderBy"] = [{field: direction} for field, direction in order_by.items()]
        if take is not None:
            args["take"] = take
        if skip is not None:
            args["skip"] = skip
        if select is not None:
            args["select"] = _process_select_fields(select, _Post_py_to_logical)
        if include is not None:
            args["include"] = _serialize_post_include(include)
        if cursor is not None:
            args["cursor"] = cursor
        if distinct is not None:
            args["distinct"] = distinct
        payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "args": args,
        }
        if chunk_size is not None:
            payload["chunkSize"] = chunk_size

        result = self._client._sync_rpc("query.findMany", payload)
        decoder = _post_projection_from_wire if select is not None else _Post_from_row
        return [decoder(row) for row in result.get("data", [])]

    

    @overload
    def find_first(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        select: None = None,
        include: Optional[Dict[str, Any]] = None,
    ) -> Optional[Post]: ...

    @overload
    def find_first(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        select: PostSelectInput,
        include: Optional[Dict[str, Any]] = None,
    ) -> Optional[PostProjection]: ...

    def find_first(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        select: Optional[PostSelectInput] = None,
        include: Optional[Dict[str, Any]] = None,
    ) -> Union[Post, PostProjection, None]:
        """Find the first Post record matching the given filters.

        Returns:
            The first matching ``Post`` instance, or ``None``.
        """
        args: Dict[str, Any] = {"take": 1}
        if where is not None:
            args["where"] = _process_where_filters(where, _Post_py_to_db)
        if order_by is not None:
            if isinstance(order_by, list):
                args["orderBy"] = order_by
            else:
                args["orderBy"] = [{field: direction} for field, direction in order_by.items()]
        if select is not None:
            args["select"] = _process_select_fields(select, _Post_py_to_logical)
        if include is not None:
            args["include"] = _serialize_post_include(include)

        payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "args": args,
        }
        result = self._client._sync_rpc("query.findFirst", payload)
        row = _first_data_row(result)
        if row is None:
            return None
        decoder = _post_projection_from_wire if select is not None else _Post_from_row
        return decoder(row)

    @overload
    def find_unique(
