        include: Optional[Dict[str, Any]] = None,
    ) -> PostProjection: ...

    def find_unique_or_throw(
        self,
        *,
        where: PostWhereInput,
        select: Optional[PostSelectInput] = None,
        include: Optional[Dict[str, Any]] = None,
    ) -> Union[Post, PostProjection]:
        """Find a single Post record by a unique filter, or raise if not found.

        Returns:
            The matching ``Post`` instance.

        Raises:
            NotFoundError: If no record matches the given filter.
        """
        from ..errors import NotFoundError
        record = self.find_unique(where=where, select=select, include=include)
        if record is None:
            raise NotFoundError(
                f"findUniqueOrThrow: no Post record found matching the given filter"
            )
        return record

