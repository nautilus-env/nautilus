class IntFieldUpdate(TypedDict, total=False):
    """Atomic update operators for an integer column.

    ``set`` writes the operand as given; the others let the database derive the
    new value from the row's current one, so concurrent updates do not overwrite
    each other. Name one operator at a time.
    """
    set: NotRequired[int]
    increment: NotRequired[int]
    decrement: NotRequired[int]
    multiply: NotRequired[int]
    divide: NotRequired[int]


