    def create(self, data: PostCreateInput, *, return_data: bool = True) -> Optional[Post]:
        """Create a new Post record.

        Args:
            data: Field values for the new record.
            return_data: When ``True`` (default) the created record is returned.
                Set to ``False`` for fire-and-forget inserts to avoid the
                round-trip overhead of ``RETURNING``.

        Returns:
            The newly created ``Post`` instance, or ``None`` when
            ``return_data=False``.
        """
        _args: Dict[str, Any] = {"data": data, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "data": _process_create_data(data, _Post_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _post_event_context(
                self._client, "create", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = run_crud_event_sync(_before_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("create", return_data))

            result = self._client._sync_rpc("query.create", _payload)
            if not return_data:
                _decoded = None
            else:
                data_rows = result.get("data", [])
                if not data_rows:
                    raise RuntimeError("Create operation returned no data")
                _decoded = _Post_from_row(data_rows[0])

            _after_ctx = _post_event_context(
                self._client,
                "create",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = run_crud_event_sync(_after_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("create", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _post_event_context(
                self._client,
                "create",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            run_crud_event_sync(_error_ctx, handle_stop_propagation=False)
            raise

    def create_many(
        self,
        data: List[PostCreateInput],
        *,
        return_data: bool = True,
    ) -> List[Post]:
        """Create multiple Post records in a single batch.

        Args:
            data: List of field-value dicts for the records to create.
            return_data: When ``True`` (default) the created records are returned.
                Set to ``False`` for bulk inserts to skip ``RETURNING`` overhead.

        Returns:
            The list of newly created ``Post`` instances, or an empty
            list when ``return_data=False``.
        """
        _args: Dict[str, Any] = {"data": data, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "data": [_process_create_data(_entry, _Post_py_to_db) for _entry in data],
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _post_event_context(
                self._client, "createMany", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = run_crud_event_sync(_before_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("createMany", return_data))

            result = self._client._sync_rpc("query.createMany", _payload)
            _decoded = [] if not return_data else [
                _Post_from_row(row) for row in result.get("data", [])
            ]

            _after_ctx = _post_event_context(
                self._client,
                "createMany",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = run_crud_event_sync(_after_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("createMany", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _post_event_context(
                self._client,
                "createMany",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            run_crud_event_sync(_error_ctx, handle_stop_propagation=False)
            raise

    def update(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        data: PostUpdateInput,
        return_data: bool = True,
    ):
        """Update Post records matching ``where``.

        Args:
            where: Filter conditions. If ``None``, all records are updated.
            data: Fields to update.
            return_data: When ``True`` (default) returns the updated records.
                Set to ``False`` for bulk updates to skip ``RETURNING`` overhead;
                the affected-row count is returned instead.

        Returns:
            ``List[Post]`` when ``return_data=True``, or ``int``
            (affected-row count) when ``return_data=False``.
        """
        _args: Dict[str, Any] = {
            "where": where,
            "data": data,
            "return_data": return_data,
        }
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "filter": _process_where_filters(where or {}, _Post_py_to_db),
            "data": _process_create_data(data, _Post_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _post_event_context(
                self._client, "update", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = run_crud_event_sync(_before_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("update", return_data))

            result = self._client._sync_rpc("query.update", _payload)
            if not return_data:
                _decoded = result.get("count", 0)
            else:
                _decoded = [_Post_from_row(row) for row in result.get("data", [])]

            _after_ctx = _post_event_context(
                self._client,
                "update",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = run_crud_event_sync(_after_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("update", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _post_event_context(
                self._client,
                "update",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            run_crud_event_sync(_error_ctx, handle_stop_propagation=False)
            raise

    def delete(
        self,
        *,
        where: PostWhereInput,
        return_data: bool = True,
    ) -> Optional["Post"]:
        """Delete the first Post record matching ``where``.

        Finds the first matching record and deletes it by its primary key.

        Args:
            where: Filter conditions. Required.
            return_data: When ``True`` (default) returns the deleted record.
                Set to ``False`` to skip ``RETURNING`` overhead; ``None`` is
                returned in that case.

        Returns:
            The deleted ``Post`` instance when ``return_data=True``,
            or ``None`` when ``return_data=False``.

        Raises:
            NotFoundError: If no record matches the given filter.
        """
        from ..errors import NotFoundError
        record = self.find_first(where=where)
        if record is None:
            raise NotFoundError(
                f"delete: no Post record found matching the given filter"
            )
        pk_filter = {
            "id": getattr(record, "id"),
        }
        _args: Dict[str, Any] = {"where": where, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "filter": _process_where_filters(pk_filter, _Post_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _post_event_context(
                self._client, "delete", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = run_crud_event_sync(_before_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("delete", return_data))

            result = self._client._sync_rpc("query.delete", _payload)
            if return_data:
                data_rows = result.get("data", [])
                if data_rows:
                    _decoded = _Post_from_row(data_rows[0])
                else:
                    _decoded = record
            else:
                _decoded = None

            _after_ctx = _post_event_context(
                self._client,
                "delete",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = run_crud_event_sync(_after_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("delete", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _post_event_context(
                self._client,
                "delete",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            run_crud_event_sync(_error_ctx, handle_stop_propagation=False)
            raise

    def delete_many(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        return_data: bool = False,
    ):
        """Delete all Post records matching ``where``.

        Args:
            where: Filter conditions. If ``None``, all records are deleted.
            return_data: When ``True`` returns the deleted records (uses
                ``RETURNING``). Defaults to ``False`` for efficiency.

        Returns:
            ``int`` (affected-row count) when ``return_data=False`` (default),
            or ``List[Post]`` when ``return_data=True``.
        """
        _args: Dict[str, Any] = {"where": where, "return_data": return_data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "filter": _process_where_filters(where or {}, _Post_py_to_db),
            "returnData": return_data,
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _post_event_context(
                self._client, "deleteMany", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = run_crud_event_sync(_before_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("deleteMany", return_data))

            _method = "query.delete" if return_data else "query.deleteMany"
            result = self._client._sync_rpc(_method, _payload)
            if return_data:
                _decoded = [_Post_from_row(row) for row in result.get("data", [])]
            else:
                _decoded = result.get("count", 0)

            _after_ctx = _post_event_context(
                self._client,
                "deleteMany",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = run_crud_event_sync(_after_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("deleteMany", return_data))
            return _decoded
        except Exception as _error:
            _error_ctx = _post_event_context(
                self._client,
                "deleteMany",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            run_crud_event_sync(_error_ctx, handle_stop_propagation=False)
            raise

    def update_many(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        data: PostUpdateInput,
    ) -> int:
        """Update every Post record matching ``where``.

        Unlike :meth:`update`, no rows are returned: the engine runs one
        statement without a ``RETURNING`` clause however many rows it touches.

        Args:
            where: Filter conditions. If ``None``, all records are updated.
            data: Fields to update.

        Returns:
            The affected-row count.
        """
        _args: Dict[str, Any] = {"where": where, "data": data}
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "filter": _process_where_filters(where or {}, _Post_py_to_db),
            "data": _process_create_data(data, _Post_py_to_db),
        }
        _state: Dict[str, Any] = {}
        try:
            _before_ctx = _post_event_context(
                self._client, "updateMany", EventPhase.BEFORE, _args, _payload, _state
            )
            _stop = run_crud_event_sync(_before_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("updateMany"))

            result = self._client._sync_rpc("query.updateMany", _payload)
            _decoded = result.get("count", 0)

            _after_ctx = _post_event_context(
                self._client,
                "updateMany",
                EventPhase.AFTER,
                _args,
                _payload,
                _state,
                result=_decoded,
            )
            _stop = run_crud_event_sync(_after_ctx)
            if _stop is not None:
                return resolve_stop_result(_stop, default_cud_result("updateMany"))
            return _decoded
        except Exception as _error:
            _error_ctx = _post_event_context(
                self._client,
                "updateMany",
                EventPhase.ERROR,
                _args,
                _payload,
                _state,
                error=_error,
            )
            run_crud_event_sync(_error_ctx, handle_stop_propagation=False)
            raise


    def aggregate(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        count: Optional[Union[bool, PostCountAggregateInput]] = None,

        avg: Optional[PostAvgAggregateInput] = None,
        sum: Optional[PostSumAggregateInput] = None,

        min: Optional[PostMinAggregateInput] = None,
        max: Optional[PostMaxAggregateInput] = None,
    ) -> PostAggregateOutput:
        """Aggregate over every Post record matching ``where``.

        Same aggregates as :meth:`group_by` without a grouping key, so the
        result is a single row covering the whole filtered set. A filter that
        matches nothing still yields a row: counts are ``0`` and the other
        aggregates ``None``.

        Args:
            where: Filter conditions (optional).
            count: Compute COUNT. Pass ``True`` for ``COUNT(*)`` or a
                ``PostCountAggregateInput`` dict to count specific fields.

            avg: Compute AVG for the specified numeric fields.
            sum: Compute SUM for the specified numeric fields.

            min: Compute MIN for the specified fields.
            max: Compute MAX for the specified fields.

        Returns:
            One ``PostAggregateOutput`` dict.
        """
        args: Dict[str, Any] = {}
        if where is not None:
            args["where"] = _process_where_filters(where, _Post_py_to_db)
        if count is not None:
            args["count"] = count
        if avg is not None:
            args["avg"] = avg
        if sum is not None:
            args["sum"] = sum
        if min is not None:
            args["min"] = min
        if max is not None:
            args["max"] = max

        result = self._client._sync_rpc("query.aggregate", {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "args": args,
        })
        rows = result.get("data", [])
        return rows[0] if rows else {}

    def explain(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        order_by: Optional[Union[PostOrderByInput, List[PostOrderByInput]]] = None,
        take: Optional[int] = None,
        skip: Optional[int] = None,
        select: Optional[PostSelectInput] = None,
        cursor: Optional[Dict[str, Any]] = None,
        distinct: Optional[List[str]] = None,
        analyze: bool = False,
    ) -> PostExplainOutput:
        """Ask the database to explain the statement :meth:`find_many` would run.

        Args:
            where: Filter conditions (optional).
            order_by: Sorting directions.
            take: Row limit (LIMIT).
            skip: Rows to skip (OFFSET).
            select: Scalar field projection.
            cursor: Keyset cursor.
            distinct: Field names to deduplicate on.
            analyze: Execute the statement to collect real timings. PostgreSQL
                and MySQL support this; SQLite's plan is static and ignores it.

        Returns:
            A ``PostExplainOutput`` with the rendered SQL, its bound
            parameters in placeholder order, and the plan rows.
        """
        args: Dict[str, Any] = {}
        if where is not None:
            args["where"] = _process_where_filters(where, _Post_py_to_db)
        if order_by is not None:
            if isinstance(order_by, list):
                args["orderBy"] = order_by
            else:
                args["orderBy"] = [{field: direction} for field, direction in order_by.items()]
        if take is not None:
            args["take"] = take
        if skip is not None:
            args["skip"] = skip
        if select is not None:
            args["select"] = _process_select_fields(select, _Post_py_to_logical)
        if cursor is not None:
            args["cursor"] = cursor
        if distinct is not None:
            args["distinct"] = distinct

        return self._client._sync_rpc("query.explain", {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "args": args,
            "analyze": analyze,
        })

    def count(
        self,
        *,
        where: Optional[PostWhereInput] = None,
        take: Optional[int] = None,
        skip: Optional[int] = None,
        cursor: Optional[Dict[str, Any]] = None,
    ) -> int:
        """Count the number of Post records matching the given filters.

        Args:
            where: Filter conditions (optional).
            take: Limit the count to a forward-pagination window of at most this
                  many rows.  When combined with ``skip``, counts only the rows
                  in that slice (mirrors ``findMany`` semantics).
            skip: Number of rows to skip before counting.
            cursor: Keyset cursor — combined with ``take``/``skip`` to count
                    within a paginated window.

        Returns:
            The integer count of matching records.
        """
        args: Dict[str, Any] = {}
        if where is not None:
            args["where"] = _process_where_filters(where, _Post_py_to_db)
        if take is not None:
            args["take"] = take
        if skip is not None:
            args["skip"] = skip
        if cursor is not None:
            args["cursor"] = cursor

        result = self._client._sync_rpc("query.count", {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "args": args if args else None,
        })
        return result.get("count", 0)

    def group_by(
        self,
        by: List[PostScalarFieldKeys],
        *,
        where: Optional[PostWhereInput] = None,
        having: Optional[Dict[str, Any]] = None,
        take: Optional[int] = None,
        skip: Optional[int] = None,
        count: Optional[Union[bool, PostCountAggregateInput]] = None,

        avg: Optional[PostAvgAggregateInput] = None,
        sum: Optional[PostSumAggregateInput] = None,

        min: Optional[PostMinAggregateInput] = None,
        max: Optional[PostMaxAggregateInput] = None,
        order: Optional[Union[
            Dict[PostScalarFieldKeys, SortOrder],
            List[Dict[PostScalarFieldKeys, SortOrder]],
        ]] = None,
    ) -> List[PostGroupByOutput]:
        """Group Post records and compute aggregates.

        Args:
            by: List of field names to group by. Required.
            where: Pre-group filter (applied before grouping).
            having: Post-group filter (applied after grouping), e.g.
                ``{"_count": {"_all": {"gt": 5}}}``.
            take: Maximum number of groups to return.
            skip: Number of groups to skip.
            count: Compute COUNT. Pass ``True`` for ``COUNT(*)`` or a
                ``PostCountAggregateInput`` dict to count specific fields.

            avg: Compute AVG for the specified numeric fields.
            sum: Compute SUM for the specified numeric fields.

            min: Compute MIN for the specified fields.
            max: Compute MAX for the specified fields.
            order: Sort order — a mapping or list of mappings from field name
                to ``"asc"``/``"desc"``. Aggregate keys like ``_count``,
                ``_sum``, etc. are also accepted.

        Returns:
            A list of ``PostGroupByOutput`` dicts, one per group.
        """
        args: Dict[str, Any] = {"by": list(by)}
        if where is not None:
            args["where"] = _process_where_filters(where, _Post_py_to_db)
        if having is not None:
            args["having"] = having
        if take is not None:
            args["take"] = take
        if skip is not None:
            args["skip"] = skip
        if count is not None:
            args["count"] = count

        if avg is not None:
            args["avg"] = avg
        if sum is not None:
            args["sum"] = sum

        if min is not None:
            args["min"] = min
        if max is not None:
            args["max"] = max
        if order is not None:
            if isinstance(order, list):
                args["orderBy"] = order
            else:
                args["orderBy"] = [{field: direction} for field, direction in order.items()]

        result = self._client._sync_rpc("query.groupBy", {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "args": args,
        })
        return result.get("data", [])

    def raw_query(
        self,
        sql: str,
    ) -> List[Dict[str, Any]]:
        """Execute a raw SQL string and return the result rows as dicts.

        The SQL is sent to the database as-is with no parameter binding.
        Prefer :meth:`raw_stmt_query` when user-supplied values are involved to
        avoid SQL injection.

        Args:
            sql: Raw SQL string to execute.

        Returns:
            A list of dicts mapping column name to value for each result row.
        """
        result = self._client._sync_rpc("query.rawQuery", {
            "protocolVersion": PROTOCOL_VERSION,
            "sql": sql,
        })
        return result.get("data", [])

    def raw_stmt_query(
        self,
        sql: str,
        params: Optional[List[Any]] = None,
    ) -> List[Dict[str, Any]]:
        """Execute a raw prepared-statement query with bound parameters.

        Use ``$1``, ``$2``, … (PostgreSQL) or ``?`` (MySQL / SQLite) as
        placeholders. Parameters are bound in the order they appear in *params*.

        Args:
            sql: SQL string containing parameter placeholders.
            params: Ordered list of values to bind to the placeholders.

        Returns:
            A list of dicts mapping column name to value for each result row.
        """
        result = self._client._sync_rpc("query.rawStmtQuery", {
            "protocolVersion": PROTOCOL_VERSION,
            "sql": sql,
            "params": params or [],
        })
        return result.get("data", [])
    def upsert(
        self,
        *,
        where: PostWhereInput,
        data: PostUpsertInput,
        include: Optional[Dict[str, Any]] = None,
        return_data: bool = True,
    ) -> Optional[Post]:
        """Create or update a Post record in one atomic statement.

        Runs as a single ``INSERT ... ON CONFLICT`` (``ON DUPLICATE KEY UPDATE``
        on MySQL), so no other writer can slip between the lookup and the write:
        ``data["create"]`` is inserted, and ``data["update"]`` is applied instead
        when the row already exists.

        Args:
            where: Filter naming exactly one unique constraint (or the primary
                   key); those columns become the conflict target, and
                   ``data["create"]`` must supply a value for each of them.
            data: Dict with ``create`` and ``update`` keys, each holding the
                  respective field values.
            include: Relations to eager-load on the returned record.
            return_data: When ``True`` (default) returns the record.
                Set to ``False`` to skip ``RETURNING`` overhead; ``None`` is
                returned in that case.

        Returns:
            The created or updated ``Post`` instance, or ``None`` when
            ``return_data=False``.
        """
        create_data: PostCreateInput = data.get("create", {})  # type: ignore[assignment]
        update_data: PostUpdateInput = data.get("update", {})  # type: ignore[assignment]
        _payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "filter": _process_where_filters(where or {}, _Post_py_to_db),
            "create": _process_create_data(create_data, _Post_py_to_db),
            "update": _process_create_data(update_data, _Post_py_to_db),
            "returnData": return_data,
        }
        result = self._client._sync_rpc("query.upsert", _payload)
        if not return_data:
            return None
        data_rows = result.get("data", [])
        if not data_rows:
            raise RuntimeError("upsert: engine returned no data")
        record = _Post_from_row(data_rows[0])
        if include:
            rows = self.find_many(where=where, take=1, include=include)
            return rows[0] if rows else record
        return record





