    def find_unique(
        self,
        *,
        where: PostWhereInput,
        select: Optional[PostSelectInput] = None,
        include: Optional[Dict[str, Any]] = None,
    ) -> Union[Post, PostProjection, None]:
        """Find a single Post record by a unique filter.

        Returns:
            The matching ``Post`` instance, or ``None``.
        """
        if select is not None or include is not None:
            return self.find_first(where=where, select=select, include=include)

        payload: Dict[str, Any] = {
            "protocolVersion": PROTOCOL_VERSION,
            "model": "Post",
            "filter": _process_where_filters(where, _Post_py_to_db),
        }
        result = self._client._sync_rpc("query.findUnique", payload)
        row = _first_data_row(result)
        return _Post_from_row(row) if row is not None else None

    @overload
    def find_unique_or_throw(
        self,
        *,
        where: PostWhereInput,
        select: None = None,
        include: Optional[Dict[str, Any]] = None,
    ) -> Post: ...

    @overload
