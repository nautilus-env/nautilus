    /// Count User records matching `args`.
    pub fn count(
        &self,
        args: UserCountArgs,
    ) -> nautilus_core::Result<i64> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        if let Some(count) =
            crate::runtime::try_count_via_engine(
                &_c,
                "User",
                args.to_engine_args()?,
            )
            .await?
        {
            return Ok(count);
        }

        Err(nautilus_core::Error::InvalidQuery(
            "count queries require the embedded engine path in the generated Rust client"
                .to_string(),
        ))
        }))
    }
    /// Update every User record matching `args.where_`, returning
    /// the affected-row count.
    ///
    /// Unlike [`Self::update`], no rows are read back: the engine runs one
    /// statement without a `RETURNING` clause however many rows it touches.
    pub fn update_many(
        &self,
        args: UserUpdateArgs,
    ) -> nautilus_core::Result<u64> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let _events = _c.events().clone();
        let _transaction_id = _c.transaction_id();
        let _event_args = args.clone();
        let filter = serialize_update_filter_for_engine(args.where_.as_ref())?
            .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new()));
        let _event_data = args.data.to_engine_data()?;
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            _payload.insert("filter".to_string(), filter.clone());
            _payload.insert("data".to_string(), _event_data.clone());
            serde_json::Value::Object(_payload)
        };
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = UserUpdateManyEventContext::new(
            "User",
            crate::CrudOperation::UpdateMany,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<UserUpdateManyEventContext, u64>(
            "User",
            crate::CrudOperation::UpdateMany,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<u64> = async {
            match crate::runtime::try_update_many_via_engine(
                &_c,
                "User",
                filter,
                _event_data,
            )
            .await?
            {
                Some(count) => Ok(count),
                None => Err(nautilus_core::Error::InvalidQuery(
                    "updateMany requires the embedded engine path in the generated Rust client"
                        .to_string(),
                )),
            }
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = UserUpdateManyEventContext::new(
                    "User",
                    crate::CrudOperation::UpdateMany,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded)
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<UserUpdateManyEventContext, u64>(
                    "User",
                    crate::CrudOperation::UpdateMany,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = UserUpdateManyEventContext::new(
                    "User",
                    crate::CrudOperation::UpdateMany,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<UserUpdateManyEventContext, u64>(
                    "User",
                    crate::CrudOperation::UpdateMany,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
        }))
    }

    /// Delete every User record matching `args.where_`, returning
    /// the affected-row count.
    ///
    /// The count-only counterpart of [`Self::delete_many`], which reads the
    /// deleted rows back through `RETURNING`.
    pub fn delete_many_count(
        &self,
        args: UserDeleteArgs,
    ) -> nautilus_core::Result<u64> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let filter = match args.where_.as_ref() {
            Some(filter) => serialize_update_filter_for_engine(Some(filter))?
                .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new())),
            None => serde_json::Value::Object(serde_json::Map::new()),
        };
        if let Some(count) =
            crate::runtime::try_delete_many_via_engine(
                &_c,
                "User",
                filter,
            )
            .await?
        {
            return Ok(count);
        }

        Err(nautilus_core::Error::InvalidQuery(
            "deleteMany requires the embedded engine path in the generated Rust client"
                .to_string(),
        ))
        }))
    }


    /// Aggregate over every User record matching `args.where_`,
    /// without a grouping key.
    ///
    /// Always resolves to one row, even when the filter matches nothing: counts
    /// are then `0` and the other aggregates `None`.
    pub fn aggregate(
        &self,
        args: UserAggregateArgs,
    ) -> nautilus_core::Result<UserAggregateOutput> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let engine_args = args.to_engine_args()?;
        if let Some(row) =
            crate::runtime::try_aggregate_row_via_engine(
                &_c,
                "User",
                engine_args,
            )
            .await?
        {
            return match row {
                Some(row) => UserAggregateOutput::from_row(&row),
                None => Ok(UserAggregateOutput::default()),
            };
        }

        Err(nautilus_core::Error::InvalidQuery(
            "aggregate queries require the embedded engine path in the generated Rust client"
                .to_string(),
        ))
        }))
    }

    /// Ask the database to explain the statement [`Self::find_many`] would run
    /// for `args`.
    ///
    /// `args.include` relations are loaded by separate statements and are not
    /// part of the reported plan. `analyze` executes the statement to collect
    /// real timings where the backend supports it.
    pub fn explain(
        &self,
        args: nautilus_core::FindManyArgs,
        analyze: bool,
    ) -> nautilus_core::Result<nautilus_protocol::ExplainResult> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        if let Some(result) =
            crate::runtime::try_explain_via_engine(
                &_c,
                "User",
                &args,
                analyze,
            )
            .await?
        {
            return Ok(result);
        }

        Err(nautilus_core::Error::InvalidQuery(
            "explain requires the embedded engine path in the generated Rust client".to_string(),
        ))
        }))
    }

    /// Group User rows and compute aggregates.
    pub fn group_by(
        &self,
        args: UserGroupByArgs,
    ) -> nautilus_core::Result<Vec<UserGroupByOutput>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let engine_args = args.to_engine_args()?;
        if let Some(rows) =
            crate::runtime::try_group_by_rows_via_engine(
                &_c,
                "User",
                engine_args,
            )
            .await?
        {
            let mut decoded = Vec::with_capacity(rows.len());
            for row in &rows {
                decoded.push(UserGroupByOutput::from_row(row)?);
            }
            return Ok(decoded);
        }

        Err(nautilus_core::Error::InvalidQuery(
            "groupBy queries require the embedded engine path in the generated Rust client"
                .to_string(),
        ))
        }))
    }

    /// Execute a raw SQL string and return the result rows as generic maps.
    ///
    /// The SQL is sent to the database as-is with no parameter binding.
    /// Prefer `raw_stmt_query` when user-supplied values are involved to avoid
    /// SQL injection.
    pub fn raw_query(
        &self,
        sql: impl Into<String>,
    ) -> nautilus_core::Result<Vec<std::collections::HashMap<String, serde_json::Value>>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let sql_obj = nautilus_dialect::Sql { text: sql.into(), params: vec![] };
        let stream = _c.executor().execute(&sql_obj);
        futures::pin_mut!(stream);
        let mut results: Vec<std::collections::HashMap<String, serde_json::Value>> = Vec::new();
        while let Some(result) = stream.next().await {
            let row: crate::Row = result
                .map_err(|e| nautilus_core::Error::Other(e.to_string()))?
                .into();
            let map = row
                .iter()
                .map(|(name, val)| {
                    let json_val = val.to_json_plain();
                    (name.to_string(), json_val)
                })
                .collect();
            results.push(map);
        }
        Ok(results)
        }))
    }

    /// Execute a raw prepared-statement query with bound parameters.
    ///
    /// Use `$1`, `$2`, … (PostgreSQL) or `?` (MySQL / SQLite) as placeholders.
    /// Parameters are bound in the order they appear in the `params` slice.
    pub fn raw_stmt_query(
        &self,
        sql: impl Into<String>,
        params: Vec<nautilus_core::Value>,
    ) -> nautilus_core::Result<Vec<std::collections::HashMap<String, serde_json::Value>>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let sql_obj = nautilus_dialect::Sql { text: sql.into(), params };
        let stream = _c.executor().execute(&sql_obj);
        futures::pin_mut!(stream);
        let mut results: Vec<std::collections::HashMap<String, serde_json::Value>> = Vec::new();
        while let Some(result) = stream.next().await {
            let row: crate::Row = result
                .map_err(|e| nautilus_core::Error::Other(e.to_string()))?
                .into();
            let map = row
                .iter()
                .map(|(name, val)| {
                    let json_val = val.to_json_plain();
                    (name.to_string(), json_val)
                })
                .collect();
            results.push(map);
        }
        Ok(results)
        }))
    }
    /// Create or update a User record.
    ///
    /// When the embedded engine is available this runs as a single atomic
    /// `INSERT ... ON CONFLICT` statement, so no other writer can slip between
    /// the lookup and the write. `args.where_` must name exactly one unique
    /// constraint (or the primary key). Against a standalone executor the
    /// operation falls back to a lookup followed by an update or a create.
    ///
    /// Executes immediately and returns the created or updated `User`
    /// (or `None` when `args.return_data` is `false`).
    pub fn upsert(
        &self,
        args: UserUpsertArgs,
    ) -> nautilus_core::Result<Option<User>> {
        if args.create.has_nested_writes() || args.update.has_nested_writes() {
            return Err(nautilus_core::Error::InvalidQuery(
                "upsert on 'User' does not accept nested writes; use create or update"
                    .to_string(),
            ));
        }
        let _engine_filter = serialize_update_filter_for_engine(args.where_.as_ref())?;
        let _upsert_client = self.client.clone();
        let _engine_create = args.create.to_engine_data()?;
        let _engine_update = args.update.to_engine_data()?;
        let _engine_rows: Option<Vec<User>> = tokio::task::block_in_place(|| {
            tokio::runtime::Handle::current().block_on(async move {
                let Some(filter_json) = _engine_filter else {
                    return Ok(None);
                };
                crate::runtime::try_upsert_via_engine::<_, User>(
                    &_upsert_client,
                    "User",
                    filter_json,
                    _engine_create,
                    _engine_update,
                    |row| {
                        decode_model_row_with_hints(
                            row,
                            all_scalar_decode_slots(),
                            all_scalar_value_hints(),
                        )
                    },
                )
                .await
            })
        })?;

        if let Some(rows) = _engine_rows {
            if !args.return_data {
                return Ok(None);
            }
            return Ok(rows.into_iter().next());
        }

        let has_update_assignments = args.update.has_assignments();

        if self.client.dialect().supports_returning() && has_update_assignments {
            let updated = self.update(UserUpdateArgs {
                where_: args.where_.clone(),
                data: args.update.clone(),
            })?;

            if let Some(record) = updated.into_iter().next() {
                if !args.return_data {
                    return Ok(None);
                }
                return Ok(Some(record));
            }
        }

        let existing = self.find_first(nautilus_core::FindManyArgs {
            where_: args.where_.clone(),
            ..Default::default()
        })?;

        if let Some(record) = existing {
            if !has_update_assignments {
                if !args.return_data {
                    return Ok(None);
                }
                return Ok(Some(record));
            }

            let updated = self.update(UserUpdateArgs {
                where_: args.where_,
                data: args.update,
            })?;
            if !args.return_data {
                return Ok(None);
            }
            Ok(Some(updated.into_iter().next().unwrap_or(record)))
        } else {
            let created = self.create(args.create)?;
            if !args.return_data {
                return Ok(None);
            }
            Ok(Some(created))
        }
    }

}


/// Resolve ORDER BY paths that target fields inside composite values.
fn composite_order_expr(
    column: &str,
) -> Option<nautilus_core::Expr> {
    match column {
        _ => None,
    }
}

/// Resolve a `nearest.field` reference to the qualified pgvector column it
/// names, accepting the logical name, the database column, and the qualified
/// `table__column` form the wire protocol uses.
fn vector_distance_column(_field: &str) -> Option<&'static str> {
    None
}

/// Build the ORDER BY expression for a pgvector nearest-neighbor search.
///
/// The restrictions mirror the engine: the search needs a positive `take` to
/// stay bounded, and it cannot be combined with backward pagination, a cursor
/// or `distinct`, all of which would fight the distance ordering.
fn nearest_order_expr(
    nearest: nautilus_core::VectorNearest,
    take: Option<i32>,
    has_cursor: bool,
    has_distinct: bool,
) -> nautilus_core::Result<nautilus_core::Expr> {
    let Some(column) = vector_distance_column(&nearest.field) else {
        return Err(nautilus_core::Error::InvalidQuery(format!(
            "'nearest.field' must reference a Vector field of User, got '{}'",
            nearest.field
        )));
    };
    if !matches!(take, Some(value) if value > 0) {
        return Err(nautilus_core::Error::InvalidQuery(
            "'nearest' requires a positive 'take' limit".to_string(),
        ));
    }
    if has_cursor {
        return Err(nautilus_core::Error::InvalidQuery(
            "'nearest' cannot be combined with 'cursor'".to_string(),
        ));
    }
    if has_distinct {
        return Err(nautilus_core::Error::InvalidQuery(
            "'nearest' cannot be combined with 'distinct'".to_string(),
        ));
    }

    Ok(nautilus_core::Expr::vector_distance(
        nearest.metric,
        nautilus_core::Expr::column(column),
        nautilus_core::Expr::param(nautilus_core::Value::Vector(nearest.query)),
    ))
}

/// Internal FindMany builder for User - use `UserDelegate::find_many(args)` instead.
pub(crate) struct UserFindMany<E: crate::Executor, S = ()> {
    client: crate::Client<E>,
    filter: Option<nautilus_core::Expr>,
    order_by: Vec<nautilus_core::OrderBy>,
    /// Positive = forward pagination, negative = backward pagination.
    take: Option<i32>,
    skip: Option<u32>,
    select: std::collections::HashSet<String>,
    /// Cursor map: PK field name -> value for stable keyset pagination.
    cursor: Option<std::collections::HashMap<String, nautilus_core::Value>>,
    /// True when `take` was negative (backward pagination).
    backward: bool,
    /// Columns to deduplicate on (SELECT DISTINCT / DISTINCT ON).
    distinct: Vec<String>,
    /// pgvector nearest-neighbor search, ordering rows by distance.
    nearest: Option<nautilus_core::VectorNearest>,
    _selection: std::marker::PhantomData<S>,
}

impl<E, S> UserFindMany<E, S>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    pub(crate) fn new(client: crate::Client<E>) -> Self {
        UserFindMany {
            client,
            filter: None,
            order_by: vec![],
            take: None,
            skip: None,
            select: std::collections::HashSet::new(),
            cursor: None,
            backward: false,
            distinct: vec![],
            nearest: None,
            _selection: std::marker::PhantomData,
        }
    }

    /// Add a WHERE filter.
    #[must_use]
    pub(crate) fn where_(mut self, expr: nautilus_core::Expr) -> Self {
        self.filter = Some(expr);
        self
    }

    /// Add ORDER BY clause.
    #[must_use]
    pub(crate) fn order_by(mut self, order: nautilus_core::OrderBy) -> Self {
        self.order_by.push(order);
        self
    }

    /// Limit the number of results.
    ///
    /// Positive `n` paginates **forward**; negative `n` paginates **backward**
    /// (flips ORDER BY and reverses the result slice in memory).
    #[must_use]
    pub(crate) fn take(mut self, n: i32) -> Self {
        self.backward = n < 0;
        self.take = Some(n);
        self
    }

    /// Skip a number of results (OFFSET).
    #[must_use]
    pub(crate) fn skip(mut self, n: u32) -> Self {
        self.skip = Some(n);
        self
    }

    /// Set the cursor for stable keyset pagination.
    ///
    /// The map must contain all primary-key fields of the model.
    /// The cursor record is included in the result.
    #[must_use]
    pub(crate) fn cursor(
        mut self,
        map: std::collections::HashMap<String, nautilus_core::Value>,
    ) -> Self {
        self.cursor = Some(map);
        self
    }

    /// Specify columns to deduplicate on (SELECT DISTINCT / DISTINCT ON).
    ///
    /// - **Postgres**: emits `DISTINCT ON (cols)` - the columns are automatically
    ///   prepended to `ORDER BY` before query execution.
    /// - **SQLite / MySQL**: emits plain `SELECT DISTINCT` (full-row dedup;
    ///   combine with `select_fields` for column-level effect).
    #[must_use]
    pub(crate) fn distinct(mut self, columns: Vec<String>) -> Self {
        self.distinct = columns;
        self
    }

    /// Order results by pgvector distance from a query embedding.
    #[must_use]
    pub(crate) fn nearest(mut self, nearest: nautilus_core::VectorNearest) -> Self {
        self.nearest = Some(nearest);
        self
    }

    fn into_execution_parts(
        self,
    ) -> nautilus_core::Result<(
        crate::Client<E>,
        nautilus_dialect::Sql,
        Vec<Option<crate::ValueHint>>,
        Vec<usize>,
        bool,
    )> {
        use nautilus_core::*;

        let UserFindMany {
            client,
            filter,
            order_by,
            take,
            skip,
            select,
            cursor,
            backward,
            distinct,
            nearest,
            _selection,
        } = self;
        let row_hints = projected_scalar_value_hints(&select);
        let decode_slots = projected_scalar_decode_slots(&select);
        let mut builder = Select::from_table("User").with_capacity(SelectCapacity {
            items: 2,
            order_by_columns: order_by.len() + distinct.len() + 1,
            order_by_exprs: usize::from(nearest.is_some()),
            distinct: distinct.len(),
            ..SelectCapacity::default()
        });

        // Add scalar columns (PK columns always included; others filtered by select if active)
        builder = builder.item(SelectItem::column(ColumnMarker::from_static("User", "id")));
        if select.is_empty() || select.contains("name") {
            builder = builder.item(SelectItem::column(ColumnMarker::from_static("User", "name")));
        }

        // Auto-add distinct columns to ORDER BY so they appear first (required for
        // Postgres DISTINCT ON; harmless for SQLite / MySQL which use plain DISTINCT).
        if !distinct.is_empty() {
            let existing_cols: std::collections::HashSet<&str> =
                order_by.iter().map(|o| o.column.as_str()).collect();
            for col in &distinct {
                if !existing_cols.contains(col.as_str()) {
                    let dir = if backward { OrderDir::Desc } else { OrderDir::Asc };
                    builder = builder.order_by(col.clone(), dir);
                }
            }
        }

        // Cursor predicate
        // Build an inclusive keyset WHERE clause from the cursor map and merge
        // it with any caller-supplied filter.
        let effective_filter = if let Some(ref cursor_map) = cursor {
            // Static PK field (cursor-map-key, table__db_col) pairs - generated
            // at code-generation time from the model's primary-key definition.
            let pk_pairs: &[(&str, &str)] = &[
                ("id", "User__id"),
            ];
            let cursor_pred =
                nautilus_core::build_cursor_predicate(pk_pairs, cursor_map, backward)?;

            // Auto-add any PK column that is not yet in order_by so that the
            // keyset predicate is unambiguous.
            let existing_cols: std::collections::HashSet<&str> =
                order_by.iter().map(|o| o.column.as_str()).collect();
            if !existing_cols.contains("id") {
                let dir = if backward { OrderDir::Desc } else { OrderDir::Asc };
                builder = builder.order_by("id".to_string(), dir);
            }

            Some(match filter {
                Some(f) => f.and(cursor_pred),
                None => cursor_pred,
            })
        } else {
            filter
        };

        if let Some(f) = effective_filter {
            builder = builder.filter(f);
        }

        if let Some(nearest) = nearest {
            let distance = nearest_order_expr(nearest, take, cursor.is_some(), !distinct.is_empty())?;
            builder = builder.order_by_expr(distance, OrderDir::Asc);
        }

        // Apply ordering, flipping direction for backward pagination.
        for order in order_by {
            let dir = if backward {
                match order.direction {
                    OrderDir::Asc => OrderDir::Desc,
                    OrderDir::Desc => OrderDir::Asc,
                }
            } else {
                order.direction
            };
            if let Some(expr) = composite_order_expr(&order.column) {
                builder = builder.order_by_expr(expr, dir);
            } else {
                builder = builder.order_by(order.column, dir);
            }
        }

        // Apply take (absolute value; direction is handled by ORDER BY flip).
        if let Some(n) = take {
            builder = builder.take(n.saturating_abs());
        }
        if let Some(offset) = skip {
            builder = builder.skip(offset);
        }

        // Apply distinct (SELECT DISTINCT / DISTINCT ON).
        if !distinct.is_empty() {
            builder = builder.distinct(distinct);
        }

        let select = builder.build()?;
        let sql = client.dialect().render_select_owned(select)?;

        Ok((client, sql, row_hints, decode_slots, backward))
    }

    fn into_selection_execution_parts<C>(
        self,
        selection: &C,
    ) -> nautilus_core::Result<(
        crate::Client<E>,
        nautilus_dialect::Sql,
        Vec<Option<crate::ValueHint>>,
        bool,
    )>
    where
        C: nautilus_core::SelectColumns,
    {
        use nautilus_core::*;

        let UserFindMany {
            client,
            filter,
            order_by,
            take,
            skip,
            select: _,
            cursor,
            backward,
            distinct,
            nearest,
            _selection,
        } = self;
        let selected_columns = selection.columns();
        let row_hints = selected_columns
            .iter()
            .map(projection_value_hint_for_column)
            .collect::<Vec<_>>();
        let mut builder = Select::from_table("User").with_capacity(SelectCapacity {
            items: selected_columns.len(),
            order_by_columns: order_by.len() + distinct.len() + 1,
            order_by_exprs: usize::from(nearest.is_some()),
            distinct: distinct.len(),
            ..SelectCapacity::default()
        });

        for column in selected_columns {
            builder = builder.item(SelectItem::column(column));
        }

        if !distinct.is_empty() {
            let existing_cols: std::collections::HashSet<&str> =
                order_by.iter().map(|o| o.column.as_str()).collect();
            for col in &distinct {
                if !existing_cols.contains(col.as_str()) {
                    let dir = if backward { OrderDir::Desc } else { OrderDir::Asc };
                    builder = builder.order_by(col.clone(), dir);
                }
            }
        }

        let effective_filter = if let Some(ref cursor_map) = cursor {
            let pk_pairs: &[(&str, &str)] = &[
                ("id", "User__id"),
            ];
            let cursor_pred =
                nautilus_core::build_cursor_predicate(pk_pairs, cursor_map, backward)?;

            let existing_cols: std::collections::HashSet<&str> =
                order_by.iter().map(|o| o.column.as_str()).collect();
            if !existing_cols.contains("id") {
                let dir = if backward { OrderDir::Desc } else { OrderDir::Asc };
                builder = builder.order_by("id".to_string(), dir);
            }

            Some(match filter {
                Some(f) => f.and(cursor_pred),
                None => cursor_pred,
            })
        } else {
            filter
        };

        if let Some(f) = effective_filter {
            builder = builder.filter(f);
        }

        if let Some(nearest) = nearest {
            let distance = nearest_order_expr(nearest, take, cursor.is_some(), !distinct.is_empty())?;
            builder = builder.order_by_expr(distance, OrderDir::Asc);
        }

        for order in order_by {
            let dir = if backward {
                match order.direction {
                    OrderDir::Asc => OrderDir::Desc,
                    OrderDir::Desc => OrderDir::Asc,
                }
            } else {
                order.direction
            };
            if let Some(expr) = composite_order_expr(&order.column) {
                builder = builder.order_by_expr(expr, dir);
            } else {
                builder = builder.order_by(order.column, dir);
            }
        }

        if let Some(n) = take {
            builder = builder.take(n.saturating_abs());
        }
        if let Some(offset) = skip {
            builder = builder.skip(offset);
        }

        if !distinct.is_empty() {
            builder = builder.distinct(distinct);
        }

        let select = builder.build()?;
        let sql = client.dialect().render_select_owned(select)?;

        Ok((client, sql, row_hints, backward))
    }
}

impl<E> UserFindMany<E, ()>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    /// Execute the query and return all rows.
    pub(crate) async fn exec(self) -> nautilus_core::Result<Vec<User>> {
        use nautilus_core::*;
        use std::convert::Into;

        let (client, sql, row_hints, decode_slots, backward) = self.into_execution_parts()?;

        let rows = crate::execute_all(client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let mut results = Vec::with_capacity(rows.len());
        for row in rows {
            let row: crate::Row = row.into();
            let decoded = decode_model_row_with_hints(row, &decode_slots, &row_hints)?;
            results.push(decoded);
        }

        // Backward pagination: DB returned rows in reversed order - restore natural order.
        if backward {
            results.reverse();
        }

        Ok(results)
    }

    /// Execute the query and decode at most one row.
    pub(crate) async fn exec_optional(self) -> nautilus_core::Result<Option<User>> {
        use nautilus_core::*;
        use std::convert::Into;

        let (client, sql, row_hints, decode_slots, _backward) = self.into_execution_parts()?;
        let row = crate::execute_optional(client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let Some(row) = row else {
            return Ok(None);
        };

        let row: crate::Row = row.into();
        Ok(Some(decode_model_row_with_hints(row, &decode_slots, &row_hints)?))
    }

    pub(crate) async fn exec_select<C>(
        self,
        selection: C,
    ) -> nautilus_core::Result<Vec<C::Output>>
    where
        C: nautilus_core::SelectColumns,
    {
        use nautilus_core::*;
        use std::convert::Into;

        let (client, sql, row_hints, backward) =
            self.into_selection_execution_parts(&selection)?;

        let rows = crate::execute_all(client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let mut results = Vec::with_capacity(rows.len());
        for row in rows {
            let row: crate::Row = row.into();
            let row = normalize_projection_row(row, &row_hints)?;
            results.push(selection.decode(&row)?);
        }

        if backward {
            results.reverse();
        }

        Ok(results)
    }

    pub(crate) async fn exec_select_optional<C>(
        self,
        selection: C,
    ) -> nautilus_core::Result<Option<C::Output>>
    where
        C: nautilus_core::SelectColumns,
    {
        use nautilus_core::*;
        use std::convert::Into;

        let (client, sql, row_hints, _backward) =
            self.into_selection_execution_parts(&selection)?;
        let row = crate::execute_optional(client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let Some(row) = row else {
            return Ok(None);
        };

        let row: crate::Row = row.into();
        let row = normalize_projection_row(row, &row_hints)?;
        Ok(Some(selection.decode(&row)?))
    }
}

/// Internal Create builder for User — use `UserDelegate::create(data)` instead.
pub(crate) struct UserCreate<E: crate::Executor> {
    client: crate::Client<E>,
    id: Option<i32>,
    name: Option<String>,
}

impl<E> UserCreate<E>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    pub(crate) fn new(client: crate::Client<E>) -> Self {
        UserCreate {
            client,
            id: None,
            name: None,
        }
    }
    /// Set id.
    #[must_use]
    pub(crate) fn id(mut self, value: impl Into<i32>) -> Self {
        self.id = Some(value.into());
        self
    }
    /// Set name.
    #[must_use]
    pub(crate) fn name(mut self, value: impl Into<String>) -> Self {
        self.name = Some(value.into());
        self
    }
    /// Execute the create query.
    pub(crate) async fn exec(self) -> nautilus_core::Result<User> {
        use nautilus_core::*;
        use std::convert::Into;

        let mut columns = Vec::with_capacity(2);
        let mut values = Vec::with_capacity(2);
        if let Some(value) = self.id {
            columns.push(ColumnMarker::from_static("User", "id"));
            values.push(Value::from(value));
        }
        if let Some(value) = self.name {
            columns.push(ColumnMarker::from_static("User", "name"));
            values.push(Value::from(value));
        }

        let mut builder = Insert::into_table("User")
            .columns(columns)
            .values(values);

        let supports_returning = self.client.dialect().supports_returning();
        if supports_returning {
            let returning_cols = vec![
                ColumnMarker::from_static("User", "id"),
                ColumnMarker::from_static("User", "name"),
            ];
            builder = builder.returning(returning_cols);
        }

        let insert = builder.build()?;
        let sql = self.client.dialect().render_insert_owned(insert)?;

        let row: Row = crate::execute_one(self.client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?
            .into();

        decode_model_row_with_hints(row, all_scalar_decode_slots(), all_scalar_value_hints())
    }
}


/// Entry for creating User.
#[derive(Debug, Clone)]
pub struct UserCreateEntry {
    pub id: i32,
    pub name: String,
}

impl UserCreateEntry {
    pub(crate) fn to_engine_data(&self) -> serde_json::Value {
        let mut data = serde_json::Map::new();
        data.insert(
            "id".to_string(),
            nautilus_core::Value::from(self.id.clone()).to_json_plain(),
        );
        data.insert(
            "name".to_string(),
            nautilus_core::Value::from(self.name.clone()).to_json_plain(),
        );
        serde_json::Value::Object(data)
    }
}

/// Internal CreateMany builder for User — use `UserDelegate::create_many(entries)` instead.
pub(crate) struct UserCreateMany<E: crate::Executor> {
    client: crate::Client<E>,
    entries: Vec<UserCreateEntry>,
}

impl<E> UserCreateMany<E>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    pub(crate) fn new(client: crate::Client<E>) -> Self {
        UserCreateMany {
            client,
            entries: vec![],
        }
    }

    /// Add an entry to the batch.
    #[must_use]
    pub(crate) fn entry(mut self, entry: UserCreateEntry) -> Self {
        self.entries.push(entry);
        self
    }

    /// Execute the batch create using a single multi-row `INSERT`.
    pub(crate) async fn exec(self) -> nautilus_core::Result<Vec<User>> {
        use nautilus_core::*;
        use std::convert::Into;

        if self.entries.is_empty() {
            return Ok(vec![]);
        }

        // MySQL does not support RETURNING — fall back to per-row inserts.
        if !self.client.dialect().supports_returning() {
            let mut results = Vec::with_capacity(self.entries.len());
            for entry in self.entries {
                let result = UserCreate::new(self.client.clone())
                    .id(entry.id)
                    .name(entry.name)
                    .exec().await?;
                results.push(result);
            }
            return Ok(results);
        }

        let columns = vec![
            ColumnMarker::from_static("User", "id"),
            ColumnMarker::from_static("User", "name"),
        ];

        let mut rows = Vec::with_capacity(self.entries.len());
        for entry in &self.entries {
            let row = vec![
                Value::from(entry.id.clone()),
                Value::from(entry.name.clone()),
            ];
            rows.push(row);
        }

        let returning_cols = vec![
            ColumnMarker::from_static("User", "id"),
            ColumnMarker::from_static("User", "name"),
        ];
        let builder = Insert::into_table("User")
            .with_capacity(InsertCapacity {
                columns: columns.len(),
                rows: rows.len(),
                returning: returning_cols.len(),
            })
            .columns(columns)
            .rows(rows)
            .returning(returning_cols);

        let insert = builder.build()?;
        let sql = self.client.dialect().render_insert_owned(insert)?;

        let rows = crate::execute_all(self.client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let mut results = Vec::with_capacity(rows.len());
        for row in rows {
            let row: crate::Row = row.into();
            let decoded = decode_model_row_with_hints(
                row,
                all_scalar_decode_slots(),
                all_scalar_value_hints(),
            )?;
            results.push(decoded);
        }

        Ok(results)
    }
}


/// Internal Update builder for User — use `UserDelegate::update(args)` instead.
pub(crate) struct UserUpdate<E: crate::Executor> {
    client: crate::Client<E>,
    filter: Option<nautilus_core::Expr>,
    require_filter: bool,
    /// Column-value assignments collected from `set_data`.
    assignments: Vec<(nautilus_core::ColumnMarker, nautilus_core::Assignment)>,
}

impl<E> UserUpdate<E>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    pub(crate) fn new(client: crate::Client<E>) -> Self {
        UserUpdate {
            client,
            filter: None,
            require_filter: true,
            assignments: Vec::with_capacity(2),
        }
    }

    /// Set WHERE filter.
    #[must_use]
    pub(crate) fn where_(mut self, expr: nautilus_core::Expr) -> Self {
        self.filter = Some(expr);
        self
    }

    /// Update all rows (removes the safety guard that requires a filter).
    #[must_use]
    pub(crate) fn all(mut self) -> Self {
        self.require_filter = false;
        self
    }

    /// Load field assignments from a structured update-input value.
    ///
    /// Only fields that are `Some(…)` in `data` are included in the SET
    /// clause; `None` fields are intentionally skipped (left unchanged).
    /// For nullable fields a `Some(None)` sets the column to NULL.
    #[must_use]
    pub(crate) fn set_data(mut self, data: UserUpdateInput) -> Self {
        if let Some(outer) = data.id {
            let assignment = outer.to_assignment("id");
            self.assignments.push((
                nautilus_core::ColumnMarker::from_static("User", "id"),
                assignment,
            ));
        }
        if let Some(outer) = data.name {
            let assignment = nautilus_core::Assignment::Value(nautilus_core::Value::from(outer));
            self.assignments.push((
                nautilus_core::ColumnMarker::from_static("User", "name"),
                assignment,
            ));
        }
        self
    }

    /// Execute the update, returning affected rows via `RETURNING`.
    ///
    /// Returns an empty `Vec` for databases that do not support `RETURNING`
    /// (e.g. MySQL).  Returns an empty `Vec` without touching the database
    /// when no assignments have been loaded via `set_data`.
    pub(crate) async fn exec(self) -> nautilus_core::Result<Vec<User>> {
        use nautilus_core::*;
        use std::convert::Into;

        if self.assignments.is_empty() {
            return Ok(vec![]);
        }

        if self.require_filter && self.filter.is_none() {
            return Err(Error::InvalidQuery(
                "Update requires a WHERE filter — call `.all()` to update every row.".to_string(),
            ));
        }

        let mut builder = Update::table("User")
            .with_capacity(UpdateCapacity {
                assignments: self.assignments.len(),
                returning: usize::from(self.client.dialect().supports_returning()) * 2,
            })
            .assignments(self.assignments);
        if let Some(filter) = self.filter {
            builder = builder.filter(filter);
        }

        let supports_returning = self.client.dialect().supports_returning();
        if supports_returning {
            let returning_cols = vec![
                ColumnMarker::from_static("User", "id"),
                ColumnMarker::from_static("User", "name"),
            ];
            builder = builder.returning(returning_cols);
        }

        let update = builder.build()?;
        let sql = self.client.dialect().render_update_owned(update)?;

        let rows = crate::execute_all(self.client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let mut results = Vec::with_capacity(rows.len());
        for row in rows {
            let row: crate::Row = row.into();
            results.push(decode_model_row_with_hints(
                row,
                all_scalar_decode_slots(),
                all_scalar_value_hints(),
            )?);
        }

        Ok(results)
    }
}


/// Internal Delete builder for User — use `UserDelegate::delete(filter)` instead.
pub(crate) struct UserDelete<E: crate::Executor> {
    client: crate::Client<E>,
    filter: Option<nautilus_core::Expr>,
    require_filter: bool,
}

impl<E> UserDelete<E>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    pub(crate) fn new(client: crate::Client<E>) -> Self {
        UserDelete {
            client,
            filter: None,
            require_filter: true,
        }
    }

    /// Set WHERE filter.
    #[must_use]
    pub(crate) fn where_(mut self, expr: nautilus_core::Expr) -> Self {
        self.filter = Some(expr);
        self
    }

    /// Delete all rows (removes the safety guard that requires a filter).
    #[must_use]
    pub(crate) fn all(mut self) -> Self {
        self.require_filter = false;
        self
    }

    /// Execute the delete, returning deleted rows via `RETURNING`.
    ///
    /// Returns an empty `Vec` for databases that do not support `RETURNING`
    /// (e.g. MySQL).
    pub(crate) async fn exec(self) -> nautilus_core::Result<Vec<User>> {
        use nautilus_core::*;
        use std::convert::Into;

        if self.require_filter && self.filter.is_none() {
            return Err(Error::InvalidQuery(
                "Delete requires a WHERE filter — call `.all()` to delete every row.".to_string(),
            ));
        }

        let mut builder = Delete::from_table("User").with_capacity(DeleteCapacity {
            returning: usize::from(self.client.dialect().supports_returning()) * 2,
        });
        if let Some(filter) = self.filter {
            builder = builder.filter(filter);
        }

        let supports_returning = self.client.dialect().supports_returning();
        if supports_returning {
            let returning_cols = vec![
                ColumnMarker::from_static("User", "id"),
                ColumnMarker::from_static("User", "name"),
            ];
            builder = builder.returning(returning_cols);
        }

        let delete = builder.build()?;
        let sql = self.client.dialect().render_delete_owned(delete)?;

        let rows = crate::execute_all(self.client.executor(), &sql)
            .await
            .map_err(|e| Error::Other(e.to_string()))?;

        let mut results = Vec::with_capacity(rows.len());
        for row in rows {
            let row: crate::Row = row.into();
            results.push(decode_model_row_with_hints(
                row,
                all_scalar_decode_slots(),
                all_scalar_value_hints(),
            )?);
        }

        Ok(results)
    }
}
