}

impl UserMinAggregateOutput {
    fn from_json_object(
        obj: &serde_json::Map<String, serde_json::Value>,
    ) -> nautilus_core::Result<Self> {
        Ok(Self {
            id: decode_optional_group_by_json_value(obj, "id")?,
            name: decode_optional_group_by_json_value(obj, "name")?,
        })
    }
}

/// Typed MAX aggregates returned by `UserDelegate::group_by()`.
#[derive(Debug, Default, Clone, PartialEq)]
pub struct UserMaxAggregateOutput {
    pub id: Option<i32>,
    pub name: Option<String>,
}

impl UserMaxAggregateOutput {
    fn from_json_object(
        obj: &serde_json::Map<String, serde_json::Value>,
    ) -> nautilus_core::Result<Self> {
        Ok(Self {
            id: decode_optional_group_by_json_value(obj, "id")?,
            name: decode_optional_group_by_json_value(obj, "name")?,
        })
    }
}

/// Structured arguments for aggregating User rows without grouping.
#[derive(Debug, Default, Clone)]
pub struct UserAggregateArgs {
    /// Optional WHERE filter.
    pub where_: Option<nautilus_core::Expr>,
    /// COUNT aggregation selection.
    pub count: Option<UserCountAggregateInput>,
    /// AVG aggregation selection.
    pub avg: Option<UserAvgAggregateInput>,
    /// SUM aggregation selection.
    pub sum: Option<UserSumAggregateInput>,
    /// MIN aggregation selection.
    pub min: Option<UserMinAggregateInput>,
    /// MAX aggregation selection.
    pub max: Option<UserMaxAggregateInput>,
}

impl UserAggregateArgs {
    fn to_engine_args(&self) -> nautilus_core::Result<serde_json::Value> {
        let mut args = serde_json::Map::new();

        if let Some(filter) = self.where_.as_ref() {
            args.insert(
                "where".to_string(),
                nautilus_core::where_expr_to_protocol_json(filter)?,
            );
        }
        if let Some(count) = self.count.as_ref().and_then(UserCountAggregateInput::to_json) {
            args.insert("count".to_string(), count);
        }
        if let Some(avg) = self.avg.as_ref().and_then(UserAvgAggregateInput::to_json) {
            args.insert("avg".to_string(), avg);
        }
        if let Some(sum) = self.sum.as_ref().and_then(UserSumAggregateInput::to_json) {
            args.insert("sum".to_string(), sum);
        }
        if let Some(min) = self.min.as_ref().and_then(UserMinAggregateInput::to_json) {
            args.insert("min".to_string(), min);
        }
        if let Some(max) = self.max.as_ref().and_then(UserMaxAggregateInput::to_json) {
            args.insert("max".to_string(), max);
        }

        Ok(serde_json::Value::Object(args))
    }
}

/// Aggregates over the whole filtered set, returned by `UserDelegate::aggregate()`.
#[derive(Debug, Default, Clone, PartialEq)]
pub struct UserAggregateOutput {
    pub _count: Option<UserCountAggregateOutput>,
    pub _avg: Option<UserAvgAggregateOutput>,
    pub _sum: Option<UserSumAggregateOutput>,
    pub _min: Option<UserMinAggregateOutput>,
    pub _max: Option<UserMaxAggregateOutput>,
}

impl UserAggregateOutput {
    fn from_row(row: &crate::Row) -> nautilus_core::Result<Self> {
        Ok(Self {
            _count: decode_optional_group_by_object(row, "_count")?
                .map(UserCountAggregateOutput::from_json_object)
                .transpose()?,
            _avg: decode_optional_group_by_object(row, "_avg")?
                .map(UserAvgAggregateOutput::from_json_object)
                .transpose()?,
            _sum: decode_optional_group_by_object(row, "_sum")?
                .map(UserSumAggregateOutput::from_json_object)
                .transpose()?,
            _min: decode_optional_group_by_object(row, "_min")?
                .map(UserMinAggregateOutput::from_json_object)
                .transpose()?,
            _max: decode_optional_group_by_object(row, "_max")?
                .map(UserMaxAggregateOutput::from_json_object)
                .transpose()?,
        })
    }
}

/// One typed row returned by `UserDelegate::group_by()`.
#[derive(Debug, Default, Clone, PartialEq)]
pub struct UserGroupByOutput {
    pub id: Option<i32>,
    pub name: Option<String>,
    pub _count: Option<UserCountAggregateOutput>,
    pub _avg: Option<UserAvgAggregateOutput>,
    pub _sum: Option<UserSumAggregateOutput>,
    pub _min: Option<UserMinAggregateOutput>,
    pub _max: Option<UserMaxAggregateOutput>,
}

impl UserGroupByOutput {
    fn from_row(row: &crate::Row) -> nautilus_core::Result<Self> {
        Ok(Self {
            id: decode_optional_group_by_row_value(row, "id")?,
            name: decode_optional_group_by_row_value(row, "name")?,
            _count: decode_optional_group_by_object(row, "_count")?
                .map(UserCountAggregateOutput::from_json_object)
                .transpose()?,
            _avg: decode_optional_group_by_object(row, "_avg")?
                .map(UserAvgAggregateOutput::from_json_object)
                .transpose()?,
            _sum: decode_optional_group_by_object(row, "_sum")?
                .map(UserSumAggregateOutput::from_json_object)
                .transpose()?,
            _min: decode_optional_group_by_object(row, "_min")?
                .map(UserMinAggregateOutput::from_json_object)
                .transpose()?,
            _max: decode_optional_group_by_object(row, "_max")?
                .map(UserMaxAggregateOutput::from_json_object)
                .transpose()?,
        })
    }
}

fn serialize_cursor_for_engine(
    cursor: &std::collections::HashMap<String, nautilus_core::Value>,
) -> serde_json::Value {
    serde_json::Value::Object(
        cursor
            .iter()
            .map(|(key, value)| (key.clone(), value.to_json_plain()))
            .collect(),
    )
}

fn decode_optional_group_by_row_value<T>(
    row: &crate::Row,
    key: &str,
) -> nautilus_core::Result<Option<T>>
where
    T: nautilus_core::FromValue,
{
    match row.get(key) {
        Some(nautilus_core::Value::Null) | None => Ok(None),
        Some(value) => <T as nautilus_core::FromValue>::from_value(value).map(Some),
    }
}

fn decode_optional_group_by_object<'a>(
    row: &'a crate::Row,
    key: &str,
) -> nautilus_core::Result<Option<&'a serde_json::Map<String, serde_json::Value>>> {
    match row.get(key) {
        Some(nautilus_core::Value::Json(serde_json::Value::Object(obj))) => Ok(Some(obj)),
        Some(nautilus_core::Value::Null) | None => Ok(None),
        Some(other) => Err(nautilus_core::Error::TypeError(format!(
            "expected object-valued aggregate '{}' in groupBy output, got {:?}",
            key, other
        ))),
    }
}

/// Decode one `_avg` / `_sum` entry of an aggregate result.
///
/// PostgreSQL computes `AVG` (and `SUM` over exact numerics) as `numeric`,
/// which the engine puts on the wire as a JSON string so no precision is lost
/// in transit; SQLite and MySQL send a plain JSON number. Both spellings decode
/// into the same Rust type here.
fn decode_optional_numeric_aggregate<T>(
    obj: &serde_json::Map<String, serde_json::Value>,
    key: &str,
) -> nautilus_core::Result<Option<T>>
where
    T: nautilus_core::FromValue + std::str::FromStr,
{
    match obj.get(key) {
        Some(serde_json::Value::String(text)) => text.parse::<T>().map(Some).map_err(|_| {
            nautilus_core::Error::TypeError(format!(
                "aggregate '{}' is not a number: {}",
                key, text
            ))
        }),
        _ => decode_optional_group_by_json_value(obj, key),
    }
}

fn decode_optional_group_by_json_value<T>(
    obj: &serde_json::Map<String, serde_json::Value>,
    key: &str,
) -> nautilus_core::Result<Option<T>>
where
    T: nautilus_core::FromValue,
{
    match obj.get(key) {
        Some(serde_json::Value::Null) | None => Ok(None),
        Some(value) => <T as nautilus_core::FromValue>::from_value_owned(
            crate::runtime::wire_value_to_core_value(key, value),
        )
        .map(Some),
    }
}
fn serialize_update_filter_for_engine(
    filter: Option<&nautilus_core::Expr>,
) -> nautilus_core::Result<Option<serde_json::Value>> {
    let filter_json = match filter {
        Some(expr) => match nautilus_core::where_expr_to_protocol_json(expr) {
            Ok(value) => value,
            Err(nautilus_core::Error::InvalidQuery(_)) => return Ok(None),
            Err(err) => return Err(err),
        },
        None => return Ok(None),
    };

    Ok(Some(filter_json))
}

fn single_record_filter_field_name(column: &str) -> Option<&'static str> {
    if column == "User__id"
        || column == "id"
    {
        return Some("id");
    }
    if column == "User__name"
        || column == "name"
    {
        return Some("name");
    }
    None
}

fn collect_single_record_filter_fields(
    expr: &nautilus_core::Expr,
    fields: &mut std::collections::HashSet<&'static str>,
) -> bool {
    use nautilus_core::{BinaryOp, Expr};

    match expr {
        Expr::Binary {
            left,
            op: BinaryOp::And,
            right,
        } => {
            collect_single_record_filter_fields(left, fields)
                && collect_single_record_filter_fields(right, fields)
        }
        Expr::Binary {
            left,
            op: BinaryOp::Eq,
            right,
        } => match (&**left, &**right) {
            (Expr::Column(column), Expr::Param(_)) | (Expr::Param(_), Expr::Column(column)) => {
                let Some(field_name) = single_record_filter_field_name(column) else {
                    return false;
                };
                fields.insert(field_name)
            }
            _ => false,
        },
        _ => false,
    }
}

fn matches_single_record_constraint(
    fields: &std::collections::HashSet<&'static str>,
    constraint: &[&str],
) -> bool {
    fields.len() == constraint.len() && constraint.iter().all(|field| fields.contains(field))
}

fn is_single_record_filter(filter: &nautilus_core::Expr) -> bool {
    const SINGLE_RECORD_CONSTRAINTS: &[&[&str]] = &[
        &["id"],
    ];

    let mut fields = std::collections::HashSet::new();
    if !collect_single_record_filter_fields(filter, &mut fields) {
        return false;
    }

    SINGLE_RECORD_CONSTRAINTS
        .iter()
        .any(|constraint| matches_single_record_constraint(&fields, constraint))
}


/// Delegate for User queries.
///
/// Obtained via `client.User` (or the model accessor). Each method
/// accepts a structured args object and executes the query immediately — no
/// extra `.exec()` call is needed.
pub struct UserDelegate<E: crate::Executor> {
    client: crate::Client<E>,
}

impl<E> UserDelegate<E>
where
    E: crate::Executor,
    for<'a> E::Row<'a>: Into<crate::Row>,
{
    pub(crate) fn new(client: crate::Client<E>) -> Self {
        UserDelegate { client }
    }

    fn build_find_many_builder(
        client: crate::Client<E>,
        args: nautilus_core::FindManyArgs,
    ) -> nautilus_core::Result<UserFindMany<E>> {
        Self::reject_select_for_model_result(&args.select)?;
        if !args.include.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "include queries require the embedded engine path in the generated Rust client"
                    .to_string(),
            ));
        }

        let mut builder = UserFindMany::new(client);
        if let Some(filter) = args.where_ {
            builder = builder.where_(filter);
        }
        for order in args.order_by {
            builder = builder.order_by(order);
        }
        if let Some(take) = args.take {
            builder = builder.take(take);
        }
        if let Some(skip) = args.skip {
            builder = builder.skip(skip);
        }
        if let Some(cursor) = args.cursor {
            builder = builder.cursor(cursor);
        }
        if !args.distinct.is_empty() {
            builder = builder.distinct(args.distinct);
        }
        if let Some(nearest) = args.nearest {
            builder = builder.nearest(nearest);
        }

        Ok(builder)
    }

    fn reject_select_for_model_result(
        select: &std::collections::HashMap<String, bool>,
    ) -> nautilus_core::Result<()> {
        if !select.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "select returns partial rows and cannot be decoded as a full User; use find_many_select, find_first_select, or find_unique_select instead"
                    .to_string(),
            ));
        }
        Ok(())
    }

    fn engine_decode_plan_for_find_many_args(
        args: &nautilus_core::FindManyArgs,
    ) -> (Vec<usize>, Vec<Option<crate::ValueHint>>) {
        Self::engine_decode_plan_for_select(&args.select)
    }

    fn engine_decode_plan_for_find_unique_args(
        args: &nautilus_core::FindUniqueArgs,
    ) -> (Vec<usize>, Vec<Option<crate::ValueHint>>) {
        Self::engine_decode_plan_for_select(&args.select)
    }

    fn engine_decode_plan_for_select(
        select: &std::collections::HashMap<String, bool>,
    ) -> (Vec<usize>, Vec<Option<crate::ValueHint>>) {
        let selected_fields: std::collections::HashSet<String> = select
            .iter()
            .filter_map(|(key, enabled)| enabled.then_some(key.clone()))
            .collect();

        (
            projected_scalar_decode_slots(&selected_fields),
            projected_scalar_value_hints(&selected_fields),
        )
    }

    /// Find all User records matching `args`.
    ///
    /// Executes immediately and returns a `Vec<User>`.
    /// Prefer this when the caller naturally wants the whole result set in
    /// memory, such as small pages, eager-loaded relation graphs, or code that
    /// does further in-memory sorting/grouping.
    pub fn find_many(
        &self,
        args: nautilus_core::FindManyArgs,
    ) -> nautilus_core::Result<Vec<User>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        Self::reject_select_for_model_result(&args.select)?;
        let (engine_decode_slots, engine_row_hints) =
            Self::engine_decode_plan_for_find_many_args(&args);
        if let Some(rows) =
            crate::runtime::try_find_many_via_engine::<_, User>(
                &_c,
                "User",
                &args,
                move |row| {
                    decode_model_row_with_hints(row, &engine_decode_slots, &engine_row_hints)
                },
            )
            .await?
        {
            return Ok(rows);
        }

        let builder = Self::build_find_many_builder(
            _c,
            args,
        )?;
        builder.exec().await
        }))
    }

    /// Find the first User record matching `args`, or `None`.
    pub fn find_first(
        &self,
        args: nautilus_core::FindManyArgs,
    ) -> nautilus_core::Result<Option<User>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        Self::reject_select_for_model_result(&args.select)?;
        let args = nautilus_core::FindManyArgs { take: Some(1), ..args };
        let (engine_decode_slots, engine_row_hints) =
            Self::engine_decode_plan_for_find_many_args(&args);
        if let Some(rows) =
            crate::runtime::try_find_many_via_engine::<_, User>(
                &_c,
                "User",
                &args,
                move |row| {
                    decode_model_row_with_hints(row, &engine_decode_slots, &engine_row_hints)
                },
            )
            .await?
        {
            return Ok(rows.into_iter().next());
        }

        let builder = Self::build_find_many_builder(
            _c,
            args,
        )?;
        builder.exec_optional().await
        }))
    }

    /// Find a single User record by a unique filter, or `None` if not found.
    ///
    /// `args.where_` should reference a `@id` or `@unique` field for correct semantics.
    pub fn find_unique(
        &self,
        args: nautilus_core::FindUniqueArgs,
    ) -> nautilus_core::Result<Option<User>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        Self::reject_select_for_model_result(&args.select)?;
        let (engine_decode_slots, engine_row_hints) =
            Self::engine_decode_plan_for_find_unique_args(&args);
        if let Some(record) =
            crate::runtime::try_find_unique_via_engine::<_, User>(
                &_c,
                "User",
                &args,
                move |row| {
                    decode_model_row_with_hints(row, &engine_decode_slots, &engine_row_hints)
                },
            )
            .await?
        {
            return Ok(Some(record));
        }

        let find_args = nautilus_core::FindManyArgs {
            where_: Some(args.where_),
            take: Some(1),
            select: args.select,
            include: args.include,
            ..Default::default()
        };
        let builder = Self::build_find_many_builder(
            _c,
            find_args,
        )?;
        builder.exec_optional().await
        }))
    }

    /// Find a single User record by a unique filter, or return `Error::NotFound`.
    pub fn find_unique_or_throw(
        &self,
        args: nautilus_core::FindUniqueArgs,
    ) -> nautilus_core::Result<User> {
        self.find_unique(args)?.ok_or_else(|| {
            nautilus_core::Error::NotFound(
                format!("No {} record found matching the given unique filter", "User")
            )
        })
    }

    /// Find the first User record matching `args`, or return `Error::NotFound`.
    pub fn find_first_or_throw(
        &self,
        args: nautilus_core::FindManyArgs,
    ) -> nautilus_core::Result<User> {
        self.find_first(args)?.ok_or_else(|| {
            nautilus_core::Error::NotFound(
                format!("No {} record found matching the given filter", "User")
            )
        })
    }

    /// Find all User records with a typed scalar projection.
    pub fn find_many_select<C, F>(
        &self,
        args: nautilus_core::FindManyArgs,
        columns: F,
    ) -> nautilus_core::Result<Vec<C::Output>>
    where
        C: nautilus_core::SelectColumns,
        F: FnOnce(UserColumns) -> C,
    {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        if !args.include.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "include is not supported by typed select projections".to_string(),
            ));
        }
        if !args.select.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "FindManyArgs.select is ignored by typed select projections; pass projected columns to find_many_select instead"
                    .to_string(),
            ));
        }
        let selection = columns(UserColumns);
        let builder = Self::build_find_many_builder(
            _c,
            nautilus_core::FindManyArgs {
                select: Default::default(),
                include: Default::default(),
                ..args
            },
        )?;
        builder.exec_select(selection).await
        }))
    }

    /// Find the first User record with a typed scalar projection.
    pub fn find_first_select<C, F>(
        &self,
        args: nautilus_core::FindManyArgs,
        columns: F,
    ) -> nautilus_core::Result<Option<C::Output>>
    where
        C: nautilus_core::SelectColumns,
        F: FnOnce(UserColumns) -> C,
    {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        if !args.include.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "include is not supported by typed select projections".to_string(),
            ));
        }
        if !args.select.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "FindManyArgs.select is ignored by typed select projections; pass projected columns to find_first_select instead"
                    .to_string(),
            ));
        }
        let selection = columns(UserColumns);
        let args = nautilus_core::FindManyArgs {
            take: Some(1),
            select: Default::default(),
            include: Default::default(),
            ..args
        };
        let builder = Self::build_find_many_builder(
            _c,
            args,
        )?;
        builder.exec_select_optional(selection).await
        }))
    }

    /// Find a unique User record with a typed scalar projection.
    pub fn find_unique_select<C, F>(
        &self,
        args: nautilus_core::FindUniqueArgs,
        columns: F,
    ) -> nautilus_core::Result<Option<C::Output>>
    where
        C: nautilus_core::SelectColumns,
        F: FnOnce(UserColumns) -> C,
    {
        if !args.select.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "FindUniqueArgs.select is ignored by typed select projections; pass projected columns to find_unique_select instead"
                    .to_string(),
            ));
        }
        if !args.include.is_empty() {
            return Err(nautilus_core::Error::InvalidQuery(
                "include is not supported by typed select projections".to_string(),
            ));
        }
        let find_args = nautilus_core::FindManyArgs {
            where_: Some(args.where_),
            take: Some(1),
            select: Default::default(),
            include: Default::default(),
            ..Default::default()
        };
        self.find_first_select(find_args, columns)
    }

    /// Create a new User record.
    ///
    /// Executes immediately and returns the created `User`.
    pub fn create(
        &self,
        data: UserCreateInput,
    ) -> nautilus_core::Result<User> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let _events = _c.events().clone();
        let _transaction_id = _c.transaction_id();
        let _event_args = data.clone();
        let _event_payload = data.to_engine_data()?;
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = UserCreateEventContext::new(
            "User",
            crate::CrudOperation::Create,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<UserCreateEventContext, User>(
            "User",
            crate::CrudOperation::Create,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<User> = async {
            if let Some(record) =
                crate::runtime::try_create_via_engine::<_, User>(
                    &_c,
                    "User",
                    _event_payload.clone(),
                    data.has_nested_writes(),
                    |row| {
                        decode_model_row_with_hints(
                            row,
                            all_scalar_decode_slots(),
                            all_scalar_value_hints(),
                        )
                    },
                )
                .await?
            {
                Ok(record)
            } else {
                let mut builder = UserCreate::new(_c);
                if let Some(value) = data.id {
                    builder = builder.id(value);
                }
                if let Some(value) = data.name {
                    builder = builder.name(value);
                }
                builder.exec().await
            }
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = UserCreateEventContext::new(
                    "User",
                    crate::CrudOperation::Create,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<UserCreateEventContext, User>(
                    "User",
                    crate::CrudOperation::Create,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = UserCreateEventContext::new(
                    "User",
                    crate::CrudOperation::Create,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<UserCreateEventContext, User>(
                    "User",
                    crate::CrudOperation::Create,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
        }))
    }

    /// Create multiple User records in a single batch.
    ///
    /// Executes immediately and returns the created records.
    pub fn create_many(
        &self,
        entries: Vec<UserCreateEntry>,
    ) -> nautilus_core::Result<Vec<User>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let _events = _c.events().clone();
        let _transaction_id = _c.transaction_id();
        let _event_args = entries.clone();
        let _event_payload = serde_json::Value::Array(
            entries.iter().map(UserCreateEntry::to_engine_data).collect(),
        );
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = UserCreateManyEventContext::new(
            "User",
            crate::CrudOperation::CreateMany,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<UserCreateManyEventContext, Vec<User>>(
            "User",
            crate::CrudOperation::CreateMany,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Vec<User>> = async {
            if entries.is_empty() {
                return Ok(vec![]);
            }

            if let Some(rows) =
                crate::runtime::try_create_many_via_engine::<_, User>(
                    &_c,
                    "User",
                    entries.iter().map(UserCreateEntry::to_engine_data).collect(),
                    |row| {
                        decode_model_row_with_hints(
                            row,
                            all_scalar_decode_slots(),
                            all_scalar_value_hints(),
                        )
                    },
                )
                .await?
            {
                return Ok(rows);
            }

            let mut builder = UserCreateMany::new(_c);
            for entry in entries {
                builder = builder.entry(entry);
            }
            builder.exec().await
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = UserCreateManyEventContext::new(
                    "User",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<UserCreateManyEventContext, Vec<User>>(
                    "User",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = UserCreateManyEventContext::new(
                    "User",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<UserCreateManyEventContext, Vec<User>>(
                    "User",
                    crate::CrudOperation::CreateMany,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
        }))
    }

    /// Update User records matching `args.where_`.
    ///
    /// If `args.where_` is `None`, all rows are updated.
    /// Executes immediately and returns the updated records.
    pub fn update(
        &self,
        args: UserUpdateArgs,
    ) -> nautilus_core::Result<Vec<User>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let _events = _c.events().clone();
        let _transaction_id = _c.transaction_id();
        let _event_args = args.clone();
        let _engine_data = args.data.to_engine_data()?;
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            _payload.insert(
                "filter".to_string(),
                match serialize_update_filter_for_engine(args.where_.as_ref())? {
                    Some(value) => value,
                    None => serde_json::Value::Object(serde_json::Map::new()),
                },
            );
            _payload.insert("data".to_string(), _engine_data.clone());
            serde_json::Value::Object(_payload)
        };
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = UserUpdateEventContext::new(
            "User",
            crate::CrudOperation::Update,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<UserUpdateEventContext, Vec<User>>(
            "User",
            crate::CrudOperation::Update,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Vec<User>> = async {
            let no_assignments = _engine_data
                .as_object()
                .is_some_and(|data| data.is_empty());
            if no_assignments {
                return Ok(vec![]);
            }

            if let Some(filter_json) = serialize_update_filter_for_engine(args.where_.as_ref())? {
                if let Some(rows) =
                    crate::runtime::try_update_via_engine::<_, User>(
                        &_c,
                        "User",
                        filter_json,
                        _engine_data.clone(),
                        args.data.has_nested_writes(),
                        |row| {
                            decode_model_row_with_hints(
                                row,
                                all_scalar_decode_slots(),
                                all_scalar_value_hints(),
                            )
                        },
                    )
                    .await?
                {
                    return Ok(rows);
                }
            }

            if args.data.has_nested_writes() {
                return Err(crate::runtime::nested::writes_need_engine("User"));
            }

            let mut builder = UserUpdate::new(_c).set_data(args.data);
            if let Some(filter) = args.where_ {
                builder = builder.where_(filter);
            } else {
                builder = builder.all();
            }
            builder.exec().await
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = UserUpdateEventContext::new(
                    "User",
                    crate::CrudOperation::Update,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<UserUpdateEventContext, Vec<User>>(
                    "User",
                    crate::CrudOperation::Update,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = UserUpdateEventContext::new(
                    "User",
                    crate::CrudOperation::Update,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<UserUpdateEventContext, Vec<User>>(
                    "User",
                    crate::CrudOperation::Update,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
        }))
    }

    /// Delete the first User record matching `args.where_`.
    ///
    /// finds the first matching record and
    /// deletes it by its primary key. Returns `Ok(None)` if no record matches.
    pub fn delete(
        &self,
        args: UserDeleteArgs,
    ) -> nautilus_core::Result<Option<User>> {
        let _c = self.client.clone();
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(async move {
        let _events = _c.events().clone();
        let _transaction_id = _c.transaction_id();
        let _event_args = args.clone();
        let _event_payload = {
            let mut _payload = serde_json::Map::new();
            let _filter = match args.where_.as_ref() {
                Some(filter) => serialize_update_filter_for_engine(Some(filter))?
                    .unwrap_or_else(|| serde_json::Value::Object(serde_json::Map::new())),
                None => serde_json::Value::Object(serde_json::Map::new()),
            };
            _payload.insert("filter".to_string(), _filter);
            serde_json::Value::Object(_payload)
        };
        let mut _event_state = std::collections::HashMap::new();
        let mut _before_ctx = UserDeleteEventContext::new(
            "User",
            crate::CrudOperation::Delete,
            crate::EventPhase::Before,
            _event_args.clone(),
            _event_payload.clone(),
            _event_state,
        )
        .with_transaction_id(_transaction_id.clone());
        if let Some(_stop) = _events.run::<UserDeleteEventContext, Option<User>>(
            "User",
            crate::CrudOperation::Delete,
            crate::EventPhase::Before,
            &mut _before_ctx,
        ).await? {
            return Ok(_stop);
        }
        _event_state = _before_ctx.state;

        let _operation_result: nautilus_core::Result<Option<User>> = async {
            if let Some(filter) = args.where_.clone() {
                if _c.dialect().supports_returning() && is_single_record_filter(&filter) {
                    let deleted = UserDelete::new(_c.clone()).where_(filter).exec().await?;
                    return match deleted.len() {
                        0 => Ok(None),
                        1 => Ok(deleted.into_iter().next()),
                        count => Err(nautilus_core::Error::Other(format!(
                            "expected at most one deleted User row, got {}",
                            count
                        ))),
                    };
                }
            }

            // Find the first matching record to get its primary key
            let record = self.find_first(nautilus_core::FindManyArgs {
                where_: args.where_,
                ..Default::default()
            })?;

            let Some(record) = record else {
                return Ok(None);
            };

            // Build a primary-key filter to delete exactly that one record
            let pk_filter = nautilus_core::Expr::column("User__id").eq(nautilus_core::Expr::param(record.id.clone()));
            UserDelete::new(_c.clone()).where_(pk_filter).exec().await?;
            Ok(Some(record))
        }.await;

        match _operation_result {
            Ok(_decoded) => {
                let mut _after_ctx = UserDeleteEventContext::new(
                    "User",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::After,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_result(_decoded.clone())
                .with_transaction_id(_transaction_id);
                if let Some(_stop) = _events.run::<UserDeleteEventContext, Option<User>>(
                    "User",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::After,
                    &mut _after_ctx,
                ).await? {
                    return Ok(_stop);
                }
                Ok(_decoded)
            }
            Err(_error) => {
                let _error_text = _error.to_string();
                let mut _error_ctx = UserDeleteEventContext::new(
                    "User",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::Error,
                    _event_args,
                    _event_payload,
                    _event_state,
                )
                .with_error(_error_text)
                .with_transaction_id(_transaction_id);
                let _ = _events.run::<UserDeleteEventContext, Option<User>>(
                    "User",
                    crate::CrudOperation::Delete,
                    crate::EventPhase::Error,
                    &mut _error_ctx,
                ).await?;
                Err(_error)
            }
        }
        }))
    }

