//! User model and associated builders.
use crate::Row;
use futures::stream::StreamExt;
fn all_scalar_value_hints() -> &'static [Option<crate::ValueHint>] {
    &[
        None,
        None,
    ]
}

fn all_scalar_decode_slots() -> &'static [usize] {
    &[
        0,
        1,
    ]
}


fn projected_scalar_value_hints(
    fields: &std::collections::HashSet<String>,
) -> Vec<Option<crate::ValueHint>> {
    let mut hints = Vec::with_capacity(2);
    hints.push(None);
    if fields.is_empty() || fields.contains("name") {
        hints.push(None);
    }
    hints
}

fn projected_scalar_decode_slots(fields: &std::collections::HashSet<String>) -> Vec<usize> {
    let mut slots = Vec::with_capacity(2);
    slots.push(0);
    if fields.is_empty() || fields.contains("name") {
        slots.push(1);
    }
    slots
}

#[allow(dead_code)]
fn decode_relation_json_ref<T>(value: &nautilus_core::Value) -> Option<T>
where
    T: serde::de::DeserializeOwned,
{
    match value {
        nautilus_core::Value::Json(json) => serde::Deserialize::deserialize(json).ok(),
        _ => None,
    }
}

#[allow(dead_code)]
fn decode_relation_json_owned<T>(value: nautilus_core::Value) -> Option<T>
where
    T: serde::de::DeserializeOwned,
{
    match value {
        nautilus_core::Value::Json(json) => serde_json::from_value(json).ok(),
        _ => None,
    }
}

fn decode_model_row_with_hints(
    row: crate::Row,
    decode_slots: &[usize],
    hints: &[Option<crate::ValueHint>],
) -> nautilus_core::Result<User> {
    if decode_slots.len() != hints.len() {
        return Err(nautilus_core::Error::Other(format!(
            "Failed to decode User row: projection slot count {} does not match hint count {}",
            decode_slots.len(),
            hints.len(),
        )));
    }

    if row.len() < decode_slots.len() {
        return Err(nautilus_core::Error::TypeError(format!(
            "expected at least {} projected scalar columns for User, got {}",
            decode_slots.len(),
            row.len(),
        )));
    }
    let mut id: Option<i32> = None;
    let mut name: Option<String> = None;

    for (column_idx, (column_name, value)) in row.into_columns_iter().enumerate() {
        if column_idx >= decode_slots.len() {
            continue;
        }

        let value = match hints[column_idx] {
            Some(hint) => crate::normalize_value_with_hint(&column_name, column_idx, value, hint)
                .map_err(|e| {
                    nautilus_core::Error::Other(format!(
                        "Failed to normalize User row: {}",
                        e
                    ))
                })?,
            None => value,
        };

        match decode_slots[column_idx] {
            0 => {
                id = Some(nautilus_core::FromValue::from_value_owned(value)?);
            }
            1 => {
                name = Some(nautilus_core::FromValue::from_value_owned(value)?);
            }
            other => {
                return Err(nautilus_core::Error::TypeError(format!(
                    "unknown scalar projection slot {} while decoding User",
                    other
                )));
            }
        }
    }

    Ok(User {
        id: id.ok_or_else(|| nautilus_core::Error::TypeError(
            "missing required column 'id' (id) while decoding full User".to_string()
        ))?,
        name: name.ok_or_else(|| nautilus_core::Error::TypeError(
            "missing required column 'name' (name) while decoding full User".to_string()
        ))?,
    })
}

fn projection_value_hint_for_column(
    column: &nautilus_core::ColumnMarker,
) -> Option<crate::ValueHint> {
    if column.table.as_ref() != "User" {
        return None;
    }

    match column.name.as_ref() {
        "id" => None,
        "name" => None,
        _ => None,
    }
}

fn normalize_projection_row(
    row: crate::Row,
    hints: &[Option<crate::ValueHint>],
) -> nautilus_core::Result<crate::Row> {
    let mut normalized = crate::Row::with_capacity(row.len());
    for (idx, (column_name, value)) in row.into_columns_iter().enumerate() {
        let value = match hints.get(idx).and_then(|hint| *hint) {
            Some(hint) => crate::normalize_value_with_hint(&column_name, idx, value, hint)
                .map_err(|e| {
                    nautilus_core::Error::Other(format!(
                        "Failed to normalize User projection row: {}",
                        e
                    ))
                })?,
            None => value,
        };
        normalized.push_column(column_name, value);
    }
    Ok(normalized)
}

/// User model.
///
/// Scalar fields mirror the schema exactly. Partial `select` results use the
/// delegate projection APIs instead of this full model type.
#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
pub struct User {
    /// @id @default(autoincrement())
    pub id: i32,
    pub name: String,
}


impl User {
    /// Column accessor for id.
    pub fn id() -> nautilus_core::Column<i32> {
        nautilus_core::Column::new("User", "id")
    }
    /// Column accessor for name.
    pub fn name() -> nautilus_core::Column<String> {
        nautilus_core::Column::new("User", "name")
    }
    /// Create a delegate for User queries.
    pub fn nautilus<E>(client: &crate::Client<E>) -> UserDelegate<E>
    where
        E: crate::Executor,
        for<'a> E::Row<'a>: Into<crate::Row>,
    {
        UserDelegate::new(client.clone())
    }
}


impl crate::FromRow for User {
    fn from_row(row: &crate::Row) -> nautilus_core::Result<Self> {
        let id = row
            .get("id")
            .or_else(|| row.get("User__id"))
            .ok_or_else(|| nautilus_core::Error::TypeError(
                "missing required column 'id' (id) while decoding full User".to_string()
            ))
            .and_then(nautilus_core::FromValue::from_value)?;
        let name = row
            .get("name")
            .or_else(|| row.get("User__name"))
            .ok_or_else(|| nautilus_core::Error::TypeError(
                "missing required column 'name' (name) while decoding full User".to_string()
            ))
            .and_then(nautilus_core::FromValue::from_value)?;

        // Decode relation fields from JSON (if included via .include()).

        Ok(User {
            id,
            name,
        })
    }
}


