{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "useDefineForClassFields": false,
    "stripInternal": true,
    "newLine": "lf",
    "typeRoots": ["./node_modules/@types"],
    "rootDir": "../../crates/nautilus-codegen/templates/js/runtime",
    "outDir": "./output"
  },
  "include": ["../../crates/nautilus-codegen/templates/js/runtime/*.ts"],
  "exclude": ["../../crates/nautilus-codegen/templates/js/runtime/*.d.ts"]
}
