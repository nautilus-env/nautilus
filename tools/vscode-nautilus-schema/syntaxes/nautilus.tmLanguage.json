{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nautilus Schema",
  "scopeName": "source.nautilus",
  "fileTypes": [".nautilus"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#block-keywords" },
    { "include": "#config-keys" },
    { "include": "#field-names" },
    { "include": "#enum-variants" },
    { "include": "#expression-attributes" },
    { "include": "#index-predicate" },
    { "include": "#storage-strategies" },
    { "include": "#default-enum-values" },
    { "include": "#model-attributes" },
    { "include": "#field-attributes" },
    { "include": "#attribute-arguments" },
    { "include": "#scalar-types" },
    { "include": "#enum-value-refs" },
    { "include": "#model-type-refs" },
    { "include": "#builtin-functions" },
    { "include": "#boolean-literals" },
    { "include": "#numeric-literals" },
    { "include": "#modifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nautilus",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nautilus",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.nautilus" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.nautilus" }
          }
        }
      ]
    },
    "strings": {
      "comment": "The lexer reads both quote styles and ends a string at the end of its line",
      "patterns": [
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.nautilus",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.nautilus" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.nautilus" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nautilus",
          "match": "\\\\."
        }
      ]
    },
    "string-single": {
      "comment": "A doubled quote ('') stands for one quote, as in SQL",
      "name": "string.quoted.single.nautilus",
      "begin": "'",
      "end": "'(?!')|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.nautilus" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.nautilus" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nautilus",
          "match": "\\\\.|''"
        }
      ]
    },
    "block-keywords": {
      "patterns": [
        {
          "comment": "Import statement: 'import \"./enums.nautilus\"'",
          "match": "^\\s*(import)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.nautilus" }
          }
        },
        {
          "comment": "Block keyword followed by name: 'model User', 'view PublishedPost', 'enum Role', 'type Address', etc. — not the 'type:' argument of @@index",
          "match": "\\b(datasource|generator|model|view|enum|type)\\b(?!\\s*:)(\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.nautilus" },
            "3": { "name": "entity.name.type.nautilus" }
          }
        }
      ]
    },
    "config-keys": {
      "comment": "Known config field names inside datasource/generator blocks",
      "patterns": [
        {
          "comment": "A key whose value is one of a fixed set: the provider, the client interface, the Java build mode",
          "match": "^\\s+(provider|interface|mode)\\s*(=)\\s*((\")(postgresql|mysql|sqlite|nautilus-client-(?:rs|py|js|java)|sync|async|maven|jar)(\"))",
          "captures": {
            "1": { "name": "support.type.property-name.nautilus" },
            "2": { "name": "keyword.operator.assignment.nautilus" },
            "3": { "name": "string.quoted.double.nautilus" },
            "4": { "name": "punctuation.definition.string.begin.nautilus" },
            "5": { "name": "support.constant.property-value.nautilus" },
            "6": { "name": "punctuation.definition.string.end.nautilus" }
          }
        },
        {
          "match": "^\\s+(provider|url|direct_url|extensions|preserve_extensions|schemas|output|interface|recursive_type_depth|package|group_id|artifact_id|mode)(?=\\s*=)",
          "captures": {
            "1": { "name": "support.type.property-name.nautilus" }
          }
        }
      ]
    },
    "field-names": {
      "comment": "Field names at the start of an indented line (lowercase identifiers inside model blocks) — not an attribute argument continued on its own line",
      "match": "^\\s+([a-z_][A-Za-z0-9_]*)\\b(?!\\s*:)",
      "captures": {
        "1": { "name": "variable.other.property.nautilus" }
      }
    },
    "enum-variants": {
      "comment": "Enum variant names: an identifier alone on an indented line, or followed only by attributes or a comment",
      "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=$|@|//|/\\*)",
      "captures": {
        "1": { "name": "variable.other.property.nautilus" }
      }
    },
    "model-attributes": {
      "comment": "@@-attributes: @@map, @@id, @@unique, @@index",
      "match": "@@[A-Za-z_][A-Za-z0-9_]*",
      "name": "entity.name.function.nautilus"
    },
    "expression-attributes": {
      "comment": "@computed(...), @check(...) and @@check(...): the argument is an expression whose parenthesised groups nest",
      "begin": "(@@?(?:computed|check))\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.function.nautilus" },
        "2": { "name": "punctuation.definition.parameters.begin.nautilus" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.nautilus" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "index-predicate": {
      "comment": "The where: predicate of a partial @@index — a check expression that ends at a top-level comma or the closing paren",
      "begin": "\\b(where)\\s*(:)",
      "beginCaptures": {
        "1": { "name": "variable.parameter.nautilus" },
        "2": { "name": "punctuation.separator.colon.nautilus" }
      },
      "end": "(?=[,)])",
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "expression": {
      "comment": "The expression language of @check (comparisons, AND/OR/NOT, IN lists, a raw SQL predicate as a string) and of @computed (arithmetic, ||, function calls)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#expression-group" },
        { "include": "#expression-list" },
        {
          "comment": "Logical operators, any case",
          "match": "(?i)\\b(and|or|not)\\b",
          "name": "keyword.operator.expression.logical.nautilus"
        },
        {
          "comment": "List membership, any case",
          "match": "(?i)\\bin\\b",
          "name": "keyword.operator.expression.in.nautilus"
        },
        {
          "comment": "Boolean literals, any case: the formatter writes them back as TRUE/FALSE",
          "match": "(?i)\\b(true|false)\\b",
          "name": "constant.language.boolean.nautilus"
        },
        {
          "comment": "Storage kinds: Stored, Virtual",
          "match": "\\b(Stored|Virtual)\\b",
          "name": "constant.language.nautilus"
        },
        { "include": "#numeric-literals" },
        {
          "match": "<=|>=|<>|!=|=|<|>",
          "name": "keyword.operator.comparison.nautilus"
        },
        {
          "match": "\\|\\|",
          "name": "keyword.operator.concatenation.nautilus"
        },
        {
          "match": "[-+*/%]",
          "name": "keyword.operator.arithmetic.nautilus"
        },
        {
          "comment": "SQL function calls inside @computed",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "support.function.nautilus" }
          }
        },
        {
          "comment": "Field name references",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.property.nautilus"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.nautilus"
        }
      ]
    },
    "expression-group": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.nautilus" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.nautilus" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "expression-list": {
      "comment": "The value list of IN: bare identifiers are enum variants",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.nautilus" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.nautilus" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "match": "(?i)\\b(true|false)\\b",
          "name": "constant.language.boolean.nautilus"
        },
        { "include": "#numeric-literals" },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.property.nautilus"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.nautilus"
        }
      ]
    },
    "storage-strategies": {
      "comment": "The strategy of @store: json, native",
      "match": "(@store)\\s*(\\()\\s*(json|native)\\b",
      "captures": {
        "1": { "name": "entity.name.function.nautilus" },
        "2": { "name": "punctuation.definition.parameters.begin.nautilus" },
        "3": { "name": "constant.language.nautilus" }
      }
    },
    "default-enum-values": {
      "comment": "An enum variant as the whole argument of @default, in any case: @default(ACTIVE), @default(Buy), @default(red)",
      "match": "(@default)\\s*(\\()\\s*(?!(?:true|false)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\))",
      "captures": {
        "1": { "name": "entity.name.function.nautilus" },
        "2": { "name": "punctuation.definition.parameters.begin.nautilus" },
        "3": { "name": "variable.other.property.nautilus" }
      }
    },
    "field-attributes": {
      "comment": "@-attributes: @id, @unique, @default, @map, @relation, @store",
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "entity.name.function.nautilus"
    },
    "attribute-arguments": {
      "patterns": [
        {
          "comment": "The operator class of @@index: opclass: vector_cosine_ops",
          "match": "\\b(opclass)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.parameter.nautilus" },
            "2": { "name": "punctuation.separator.colon.nautilus" },
            "3": { "name": "constant.language.nautilus" }
          }
        },
        {
          "comment": "Argument keys in attributes: fields:, references:, name:, ef_construction:, etc.",
          "match": "\\b([a-z][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "variable.parameter.nautilus" }
          }
        },
        {
          "comment": "Referential actions and computed storage kinds: Cascade, SetNull, Restrict, NoAction, SetDefault, Stored, Virtual",
          "match": "\\b(Cascade|SetNull|Restrict|NoAction|SetDefault|Stored|Virtual)\\b",
          "name": "constant.language.nautilus"
        },
        {
          "comment": "Field references inside square brackets (single or comma-separated list) — excludes known constants and the argument key that follows a comma",
          "match": "(?<=\\[|,)\\s*(?!(?:Cascade|SetNull|Restrict|NoAction|SetDefault|Stored|Virtual)\\b)(?![A-Za-z_][A-Za-z0-9_]*\\s*:)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.property.nautilus" }
          }
        }
      ]
    },
    "enum-value-refs": {
      "comment": "Enum variant references in attribute arguments — ALL_CAPS identifiers",
      "match": "\\b([A-Z][A-Z0-9_]*)\\b(?!\\s*\\{)",
      "name": "variable.other.property.nautilus"
    },
    "model-type-refs": {
      "comment": "Model/enum type references — PascalCase identifiers that are not scalar types",
      "match": "\\b([A-Z][A-Za-z][A-Za-z0-9_]*)\\b(?!\\s*\\{)",
      "name": "constant.language.nautilus"
    },
    "scalar-types": {
      "comment": "Built-in scalar field types",
      "match": "\\b(String|Boolean|Int|BigInt|Float|Decimal|DateTime|Bytes|Json|Uuid|Jsonb|Xml|Char|VarChar|Citext|Hstore|Ltree|Geometry|Geography|Vector)\\b",
      "name": "support.type.primitive.nautilus"
    },
    "builtin-functions": {
      "comment": "Built-in default/value functions",
      "match": "\\b(uuidv7|uuid|now|autoincrement|env)\\b(?=\\s*\\()",
      "name": "support.function.nautilus"
    },
    "boolean-literals": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.nautilus"
    },
    "numeric-literals": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.nautilus"
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.array.nautilus",
          "match": "\\[\\]"
        },
        {
          "name": "storage.modifier.optional.nautilus",
          "match": "\\?"
        },
        {
          "name": "storage.modifier.not-null.nautilus",
          "match": "!"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.nautilus",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.nautilus",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.array.begin.nautilus",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.array.end.nautilus",
          "match": "\\]"
        },
        {
          "name": "punctuation.definition.parameters.begin.nautilus",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.parameters.end.nautilus",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.nautilus",
          "match": ","
        },
        {
          "name": "keyword.operator.assignment.nautilus",
          "match": "="
        },
        {
          "name": "punctuation.separator.colon.nautilus",
          "match": ":"
        }
      ]
    }
  }
}
