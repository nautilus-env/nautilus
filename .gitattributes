# Auto detect text files and perform LF normalization
* text=auto

# Snapshot content preserves generated whitespace and has portable line endings.
crates/nautilus-codegen/tests/snapshots/*.snap text eol=lf whitespace=-blank-at-eol
crates/nautilus-codegen/templates/**/*.tera whitespace=-blank-at-eol,-blank-at-eof
crates/nautilus-events-macros/tests/ui/*.stderr text eol=lf whitespace=-blank-at-eol
crates/nautilus-codegen/templates/js/runtime/* text eol=lf
tools/js-runtime/* text eol=lf
